<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="preload" href="fonts/Saira-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="app.css?v=20260812-3" />
    <link rel="stylesheet" href="BODA.VMS.Web.styles.css" />
    @* Vasim(VMS) 실행 아이콘 — 2026-08-11 브랜드 파비콘 *@
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    @* 부트 로더 — "Machined Instrument": 네이비 도면 배경 + 사각 게이지 스피너 *@
    <div id="vms-boot-loader" style="position:fixed; inset:0; display:flex; align-items:center; justify-content:center; background:linear-gradient(160deg,#001830 0%,#00264C 60%,#012A55 100%); z-index:99999; transition:opacity 0.3s;">
        <div style="text-align:center; font-family:'Segoe UI', 'Malgun Gothic', sans-serif;">
            <div style="font-size:34px; font-weight:800; letter-spacing:2px;">
                <span style="color:#FFFFFF;">BODA</span> <span style="color:#FF6724;">VMS</span>
            </div>
            <div style="font-size:10px; color:rgba(255,255,255,0.5); margin-top:8px; letter-spacing:5px;">VISION MANAGEMENT SYSTEM</div>
            <div style="margin-top:28px; width:36px; height:36px; border:2px solid rgba(255,255,255,0.18); border-top-color:#FF6724; animation:vms-spin 0.9s steps(8) infinite; display:inline-block;"></div>
        </div>
        <style>@@keyframes vms-spin { to { transform: rotate(360deg); } }</style>
    </div>
    <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/download.js"></script>
    <script src="js/boot-loader.js"></script>
</body>

</html>
