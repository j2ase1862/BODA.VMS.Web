@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

@* 8b 폼 패턴 — 외부 모노 라벨(필수 * 오렌지), 짧은 필드 2열 *@
<MudDialog>
    <DialogContent>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="vms-form">
                <div>
                    <label class="vms-form-label">@L["dialog.maintFieldName"]<span class="req">*</span></label>
                    <MudTextField @bind-Value="Model.Name"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.maintFieldDescription"]</label>
                    <MudTextField @bind-Value="Model.Description"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.maintFieldClient"]</label>
                    <MudSelect T="int?" @bind-Value="Model.ClientId" Clearable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="@(L["dialog.maintFieldClientHint"])">
                        <MudSelectItem T="int?" Value="@((int?)null)">@L["dialog.maintFieldClientAll"]</MudSelectItem>
                        @foreach (var c in _clients)
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.Id)">
                                #@c.ClientIndex.ToString("D2") @c.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="vms-form-row">
                    <div>
                        <label class="vms-form-label">@L["dialog.maintFieldInterval"]</label>
                        <MudNumericField T="int" @bind-Value="Model.IntervalDays"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="1"
                                         HelperText="@(L["dialog.maintFieldIntervalHint"])" />
                    </div>
                    <div>
                        <label class="vms-form-label">@L["dialog.maintFieldDuration"]</label>
                        <MudNumericField T="int" @bind-Value="Model.EstimatedDurationMinutes"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                    </div>
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.maintFieldNextDue"]</label>
                    <MudDatePicker @bind-Date="Model.NextDueAt"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   HelperText="@(L["dialog.maintFieldNextDueHint"])" />
                </div>
                <label class="vms-toggle">
                    <input type="checkbox" checked="@Model.IsActive" @onchange="@(e => Model.IsActive = e.Value is true)" />
                    <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                    <span class="vms-toggle-label">@L["status.active"]</span>
                </label>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Class="vms-btn">
            @(IsEdit ? L["action.update"] : L["action.create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public MaintenanceScheduleUpsertDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private List<ClientDto> _clients = new();

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(Model));
    private void Cancel() => MudDialog.Cancel();
}
