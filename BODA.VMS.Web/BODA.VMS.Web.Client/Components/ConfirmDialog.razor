@inject ILocalizer L

@* 8b — 확인 다이얼로그 공통 2종: 일반 전이 / 파괴적(삭제).
   대상 식별자는 모노 블루로 명시, 파괴적 작업은 프레임·제목·버튼을 레드 톤으로 (README 8b) *@
<MudDialog>
    <DialogContent>
        <div class="@(Danger ? "vms-confirm-danger" : "vms-confirm")">
            @if (!string.IsNullOrEmpty(TargetId))
            {
                <div class="vms-confirm-target">@TargetId</div>
            }
            <div class="vms-confirm-msg">@Message</div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Primary"
                   Class="@(Danger ? "vms-btn vms-btn-danger" : "vms-btn")">
            @(string.IsNullOrEmpty(ConfirmText) ? L["action.confirm"] : ConfirmText)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>본문 메시지 — 파괴적 작업은 되돌릴 수 없음을 문장으로 쓸 것</summary>
    [Parameter] public string Message { get; set; } = "";

    /// <summary>대상 식별자 (지시번호·이름 등) — 모노 블루로 표시</summary>
    [Parameter] public string? TargetId { get; set; }

    /// <summary>true = 파괴적 작업(삭제) — 레드 프레임/버튼</summary>
    [Parameter] public bool Danger { get; set; }

    [Parameter] public string? ConfirmText { get; set; }

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
