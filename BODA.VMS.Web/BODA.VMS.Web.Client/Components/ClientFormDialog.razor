@inject ISnackbar Snackbar
@inject ILocalizer L

@* 8b 폼 패턴 — 외부 모노 라벨, IP 는 모노 폰트 유지 *@
<MudDialog>
    <DialogContent>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="vms-form">
                <div>
                    <label class="vms-form-label">@L["dialog.clientFieldName"]</label>
                    <MudTextField @bind-Value="Model.Name"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  For="@(() => Model.Name)" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.clientFieldIp"]</label>
                    <MudTextField @bind-Value="Model.IpAddress"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="192.168.1.100"
                                  Style="font-family: var(--vms-font-mono);"
                                  For="@(() => Model.IpAddress)" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.clientFieldIndex"]</label>
                    <MudNumericField @bind-Value="Model.ClientIndex"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="0" Max="99"
                                     For="@(() => Model.ClientIndex)" />
                </div>
                <label class="vms-toggle">
                    <input type="checkbox" checked="@Model.IsActive" @onchange="@(e => Model.IsActive = e.Value is true)" />
                    <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                    <span class="vms-toggle-label">@L["status.active"]</span>
                </label>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Class="vms-btn">
            @(IsEdit ? L["action.update"] : L["action.create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ClientDto Model { get; set; } = new();

    [Parameter]
    public bool IsEdit { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(Model));
    private void Cancel() => MudDialog.Cancel();
}
