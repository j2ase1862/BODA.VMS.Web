@inject ILocalizer L

@* 8b 폼 패턴 — 외부 모노 라벨(필수 * 오렌지), 위치/좌표는 다열 그리드 *@
<MudDialog>
    <DialogContent>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="vms-form">
                <div>
                    <label class="vms-form-label">@L["dialog.warehouseFieldBarcode"]<span class="req">*</span></label>
                    <MudTextField @bind-Value="Model.Barcode"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  Style="font-family: var(--vms-font-mono);"
                                  HelperText="@(L["dialog.warehouseFieldBarcodeHint"])" />
                </div>
                <div class="vms-form-row">
                    <div>
                        <label class="vms-form-label">@L["dialog.warehouseFieldCode"]<span class="req">*</span></label>
                        <MudTextField @bind-Value="Model.Code"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </div>
                    <div>
                        <label class="vms-form-label">@L["dialog.warehouseFieldName"]<span class="req">*</span></label>
                        <MudTextField @bind-Value="Model.Name"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </div>
                </div>

                <div>
                    <label class="vms-form-label">@L["dialog.warehouseSectionLocation"]</label>
                    <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:12px;">
                        <MudTextField @bind-Value="Model.Zone" Placeholder="@(L["dialog.warehouseFieldZone"])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="Model.Rack" Placeholder="@(L["dialog.warehouseFieldRack"])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="Model.Level" Placeholder="@(L["dialog.warehouseFieldLevel"])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="Model.Bin" Placeholder="@(L["dialog.warehouseFieldBin"])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                    <div style="font-size:12px; color: var(--vms-text-secondary); margin-top:6px;">
                        @L["dialog.warehousePreview"]:
                        <span class="vms-mono" style="font-weight:700; color: #C9A05A;">@PreviewLocation()</span>
                    </div>
                </div>

                <div>
                    <label class="vms-form-label">@L["dialog.warehouseSectionCoord"]</label>
                    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px;">
                        <MudNumericField @bind-Value="Model.PosX" Placeholder="X" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudNumericField @bind-Value="Model.PosY" Placeholder="Y" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudNumericField @bind-Value="Model.PosZ" Placeholder="Z" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                </div>

                <label class="vms-toggle">
                    <input type="checkbox" checked="@Model.IsActive" @onchange="@(e => Model.IsActive = e.Value is true)" />
                    <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                    <span class="vms-toggle-label">@L["status.active"]</span>
                </label>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Class="vms-btn">
            @(IsEdit ? L["action.update"] : L["action.create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public WarehouseItemDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private string PreviewLocation()
    {
        var parts = new[] { Model.Zone, Model.Rack, Model.Level, Model.Bin }
            .Where(s => !string.IsNullOrWhiteSpace(s));
        var s = string.Join("-", parts);
        return string.IsNullOrEmpty(s) ? "—" : s;
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(Model));
    private void Cancel() => MudDialog.Cancel();
}
