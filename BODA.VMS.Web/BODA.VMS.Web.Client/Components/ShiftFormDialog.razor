@inject ISnackbar Snackbar
@inject ILocalizer L

@* 8b 폼 패턴 — 외부 모노 라벨(필수 * 오렌지), 짧은 필드 2열, 미리보기는 vms-banner *@
<MudDialog>
    <DialogContent>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="vms-form">
                <div>
                    <label class="vms-form-label">@L["dialog.shiftFieldName"]<span class="req">*</span></label>
                    <MudTextField @bind-Value="Model.Name"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  Placeholder="@(L["dialog.shiftFieldNamePlaceholder"])" />
                </div>
                <div class="vms-form-row">
                    <div>
                        <label class="vms-form-label">@L["dialog.shiftFieldStart"]</label>
                        <MudNumericField T="int" @bind-Value="Model.StartHour"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="23"
                                         HelperText="@(L["dialog.shiftFieldStartHint"])" />
                    </div>
                    <div>
                        <label class="vms-form-label">@L["dialog.shiftFieldEnd"]</label>
                        <MudNumericField T="int" @bind-Value="Model.EndHour"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="23"
                                         HelperText="@(L["dialog.shiftFieldEndHint"])" />
                    </div>
                </div>
                <div class="vms-banner info">
                    <span class="vms-banner-label">INFO</span>
                    <span class="vms-banner-text"><strong>@GetPreviewRange()</strong> · @L.Format("dialog.shiftPreviewDurationFmt", PreviewDuration)</span>
                </div>
                <label class="vms-toggle">
                    <input type="checkbox" checked="@Model.IsActive" @onchange="@(e => Model.IsActive = e.Value is true)" />
                    <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                    <span class="vms-toggle-label">@L["status.active"]</span>
                </label>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Class="vms-btn">
            @(IsEdit ? L["action.update"] : L["action.create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ShiftDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private string GetPreviewRange()
    {
        var range = L.Format("dialog.shiftPreviewRangeFmt",
            $"{Model.StartHour:D2}:00", $"{Model.EndHour:D2}:00");
        if (Model.StartHour > Model.EndHour)
            return $"{range} {L["dialog.shiftPreviewNight"]}";
        return range;
    }

    private int PreviewDuration => Model.StartHour < Model.EndHour
        ? Model.EndHour - Model.StartHour
        : 24 - Model.StartHour + Model.EndHour;

    private void Submit() => MudDialog.Close(DialogResult.Ok(Model));
    private void Cancel() => MudDialog.Cancel();
}
