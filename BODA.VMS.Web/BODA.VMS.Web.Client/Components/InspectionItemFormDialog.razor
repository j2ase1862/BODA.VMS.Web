@inject ISnackbar Snackbar
@inject ILocalizer L

@* 8b 폼 패턴 — 외부 모노 라벨(필수 * 오렌지), 카테고리 설명은 vms-banner *@
<MudDialog>
    <DialogContent>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="vms-form">
                <div>
                    <label class="vms-form-label">@L["dialog.inspParamCategory"]</label>
                    <MudSelect T="string" Value="Model.Category" ValueChanged="OnCategoryChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("Pattern")">@L["dialog.inspCategoryPattern"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Blob")">@L["dialog.inspCategoryBlob"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Dimension")">@L["dialog.inspCategoryDimension"]</MudSelectItem>
                    </MudSelect>
                </div>

                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <div class="vms-banner @GetCategoryBannerClass(Model.Category)">
                        <span class="vms-banner-label">@Model.Category.ToUpperInvariant()</span>
                        <span class="vms-banner-text">@(ParameterPresetGroup.GetCategoryDescription(Model.Category))</span>
                    </div>
                }

                <div class="vms-form-row">
                    <div>
                        <label class="vms-form-label">@L["dialog.inspFieldParamCode"]<span class="req">*</span></label>
                        <MudNumericField T="int" Value="Model.ParamCode" ValueChanged="OnParamCodeChanged"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Min="1"
                                         Style="font-family: var(--vms-font-mono);"
                                         Error="@_isDuplicate"
                                         ErrorText="@_duplicateMessage"
                                         HelperText="@(_isDuplicate ? "" : L["dialog.inspFieldParamCodeHint"])" />
                    </div>
                    <div>
                        <label class="vms-form-label">@L["dialog.inspFieldValue"]</label>
                        <MudNumericField @bind-Value="Model.ParamValue"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F4" />
                    </div>
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.inspFieldDescription"]</label>
                    <MudTextField @bind-Value="Model.Description"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="@GetDescPlaceholder(Model.Category, L)" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.inspFieldUnit"]</label>
                    <MudTextField @bind-Value="Model.Unit"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="@GetUnitPlaceholder(Model.Category)" />
                </div>
                <div class="vms-form-row">
                    <div>
                        <label class="vms-form-label">@L["dialog.inspFieldLowerLimit"]</label>
                        <MudNumericField T="double?" @bind-Value="Model.LowerLimit"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F4" Clearable="true"
                                         HelperText="@(L["dialog.inspFieldLowerLimitHint"])" />
                    </div>
                    <div>
                        <label class="vms-form-label">@L["dialog.inspFieldUpperLimit"]</label>
                        <MudNumericField T="double?" @bind-Value="Model.UpperLimit"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F4" Clearable="true"
                                         HelperText="@(L["dialog.inspFieldUpperLimitHint"])" />
                    </div>
                </div>
                <label class="vms-toggle">
                    <input type="checkbox" checked="@Model.IsActive" @onchange="@(e => Model.IsActive = e.Value is true)" />
                    <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                    <span class="vms-toggle-label">@L["status.active"]</span>
                </label>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_isDuplicate && !IsEdit)"
                   Class="vms-btn">
            @(IsEdit ? L["action.update"] : L["action.create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public RecipeParameterDto Model { get; set; } = new();

    [Parameter]
    public bool IsEdit { get; set; }

    /// <summary>
    /// 현재 레시피에 이미 존재하는 ParamCode 목록 (중복 체크용)
    /// </summary>
    [Parameter]
    public HashSet<int> ExistingCodes { get; set; } = new();

    private bool _isDuplicate;
    private string _duplicateMessage = "";

    private void OnParamCodeChanged(int newCode)
    {
        Model.ParamCode = newCode;
        CheckDuplicate(newCode);
    }

    private void CheckDuplicate(int code)
    {
        // 편집 모드에서 자기 자신의 코드는 중복이 아님
        if (IsEdit && code == Model.ParamCode)
        {
            _isDuplicate = false;
            _duplicateMessage = "";
            return;
        }

        if (ExistingCodes.Contains(code))
        {
            _isDuplicate = true;
            _duplicateMessage = L.Format("dialog.inspDuplicateCodeFmt", code);
        }
        else
        {
            _isDuplicate = false;
            _duplicateMessage = "";
        }
    }

    private void OnCategoryChanged(string newCategory)
    {
        Model.Category = newCategory;
    }

    private static string GetCategoryBannerClass(string category) => category switch
    {
        "Pattern" => "info",
        "Blob" => "warn",
        "Dimension" => "check",
        _ => "info"
    };

    private static string GetDescPlaceholder(string category, ILocalizer L) => category switch
    {
        "Pattern" => L["dialog.inspDescPlaceholderPattern"],
        "Blob" => L["dialog.inspDescPlaceholderBlob"],
        "Dimension" => L["dialog.inspDescPlaceholderDimension"],
        _ => L["dialog.inspDescPlaceholderDefault"]
    };

    private static string GetUnitPlaceholder(string category) => category switch
    {
        "Pattern" => "score, deg, ratio, mm, px",
        "Blob" => "ea, px, level",
        "Dimension" => "mm",
        _ => "mm, px, score"
    };

    private void Submit()
    {
        if (_isDuplicate && !IsEdit)
        {
            Snackbar.Add(L.Format("dialog.inspDuplicateSnackFmt", Model.ParamCode), Severity.Error);
            return;
        }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
