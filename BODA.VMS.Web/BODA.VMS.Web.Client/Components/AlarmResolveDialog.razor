@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

@* 8b 폼 패턴 — 외부 모노 라벨(필수 * 오렌지), 안내는 vms-banner *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 420px;">
            <div class="vms-banner info mb-3">
                <span class="vms-banner-label">INFO</span>
                <span class="vms-banner-text">@L["dialog.alarmResolveInfo"]</span>
            </div>

            <MudText Typo="Typo.subtitle2" Class="mb-1">@Alarm.Title</MudText>
            <MudText Typo="Typo.caption" Style="color: var(--vms-text-secondary);" Class="mb-3">
                @L.Format("dialog.alarmResolveOccurredFmt", Alarm.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))
                @(string.IsNullOrEmpty(Alarm.ClientName) ? "" : $" · {Alarm.ClientName}")
            </MudText>

            <label class="vms-form-label">@L["dialog.alarmResolveField"]<span class="req">*</span></label>
            <MudTextField @bind-Value="_resolution"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" Required="true"
                          Placeholder="@(L["dialog.alarmResolveFieldPlaceholder"])" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Submit" Disabled="@(string.IsNullOrWhiteSpace(_resolution))"
                   Class="vms-btn">
            @L["dialog.alarmResolveBtn"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AlarmEventDto Alarm { get; set; } = new();

    private string _resolution = "";

    private void Submit() => MudDialog.Close(DialogResult.Ok(_resolution));
    private void Cancel() => MudDialog.Cancel();
}
