@inject IJSRuntime JS
@inject ILocalizer L

@* 12b — 임시 비밀번호 표시 다이얼로그 (8b 폼의 읽기 전용 변형).
   서버가 1회만 반환하므로 복사 가능한 모노 텍스트로 표시 (README 12b) *@
<MudDialog>
    <DialogContent>
        <div class="vms-form">
            <div>
                <label class="vms-form-label">@L["approval.colUsername"]</label>
                <div class="vms-temp-user">@Username</div>
            </div>
            <div>
                <label class="vms-form-label">@L["approval.tempPasswordLabel"]</label>
                <div class="vms-temp-pw">
                    <span class="pw">@TempPassword</span>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               Class="vms-btn" OnClick="CopyAsync">
                        @(_copied ? L["approval.tempCopied"] : L["approval.tempCopy"])
                    </MudButton>
                </div>
            </div>
            <div class="vms-banner check">
                <span class="vms-banner-label">NOTE</span>
                <span class="vms-banner-text">@L["approval.tempShownOnce"]</span>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="vms-btn" OnClick="Close">
            @L["action.ok"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Username { get; set; } = "";
    [Parameter] public string TempPassword { get; set; } = "";

    private bool _copied;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", TempPassword);
            _copied = true;
        }
        catch { /* http 컨텍스트 등 클립보드 불가 — 수동 복사 */ }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
