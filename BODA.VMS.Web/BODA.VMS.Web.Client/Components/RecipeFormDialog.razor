@inject ISnackbar Snackbar
@inject ILocalizer L

<MudDialog>
    <DialogContent>
        @* 대상 라인 명시 — VMS 는 자기 ClientIndex 의 레시피만 내려받으므로, 다른
           라인을 선택한 채 만들면 현장에서 "만들었는데 VMS 에 안 보임"이 된다 (2026-08-10) *@
        @if (!string.IsNullOrEmpty(TargetClientLabel))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-4">
                @L.Format("dialog.recipeTargetClientFmt", TargetClientLabel)
            </MudAlert>
        }

        <MudTextField @bind-Value="Name" Label="@(L["dialog.recipeFieldName"])"
                      Variant="Variant.Outlined" Class="mb-4"
                      Placeholder="S25_BackGlass, APPLE_I15_CASE"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.MenuBook" />

        <MudTextField @bind-Value="Description" Label="@(L["dialog.recipeFieldDescription"])"
                      Variant="Variant.Outlined" Class="mb-4"
                      Placeholder="@(L["dialog.recipeFieldDescriptionPlaceholder"])"
                      Lines="2" />

        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-2">
            @L["dialog.recipeAlertInfo"]
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">@L["action.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@string.IsNullOrWhiteSpace(Name)"
                   Class="vms-btn">
            @L["action.create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>레시피가 내려갈 대상 라인 표기 (예: "#02 — OP102"). null 이면 표시 생략.</summary>
    [Parameter]
    public string? TargetClientLabel { get; set; }

    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;

    private void Submit() => MudDialog.Close(DialogResult.Ok(new RecipeDto
    {
        Name = Name,
        Description = Description
    }));

    private void Cancel() => MudDialog.Cancel();
}
