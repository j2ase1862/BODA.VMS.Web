@inject ILocalizer L

@* 프리셋 일괄 추가 전 미리보기 — 어떤 항목이 어떤 코드로 생성되는지 확인 후 진행.
   코드 번호는 호출부가 next-code 로 미리 채번해 Items 에 담아 전달한다. *@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            @L.Format("inspection.presetPreviewText", Items.Count,
                Items.FirstOrDefault()?.ParamCode ?? 0, Items.LastOrDefault()?.ParamCode ?? 0)
        </MudText>
        <MudSimpleTable Dense="true" Bordered="true" Class="mb-2">
            <thead>
                <tr>
                    <th style="width: 90px;">@L["inspection.presetPreviewColCode"]</th>
                    <th>@L["inspection.presetPreviewColDesc"]</th>
                    <th style="width: 80px;">@L["inspection.presetPreviewColUnit"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Items)
                {
                    <tr>
                        <td style="font-family: 'Roboto Mono', monospace;">#@p.ParamCode</td>
                        <td>@p.Description</td>
                        <td>@p.Unit</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["action.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="Submit">
            @L.Format("inspection.presetPreviewAddFmt", Items.Count)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public List<RecipeParameterDto> Items { get; set; } = new();

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
