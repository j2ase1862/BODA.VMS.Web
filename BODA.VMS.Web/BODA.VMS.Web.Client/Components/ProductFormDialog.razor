@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

@* 8b 폼 패턴 — 외부 모노 라벨(필수 * 오렌지), 푸터 취소 아웃라인+저장 오렌지 *@
<MudDialog>
    <DialogContent>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="vms-form">
                <div>
                    <label class="vms-form-label">@L["dialog.productFieldCode"]<span class="req">*</span></label>
                    <MudTextField @bind-Value="Model.Code"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  HelperText="@(L["dialog.productFieldCodeHint"])" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.productFieldName"]<span class="req">*</span></label>
                    <MudTextField @bind-Value="Model.Name"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.productFieldSpec"]</label>
                    <MudTextField @bind-Value="Model.Specification"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                                  HelperText="@(L["dialog.productFieldSpecHint"])" />
                </div>
                <div>
                    <label class="vms-form-label">@L["dialog.productFieldDefaultRecipe"]</label>
                    <MudSelect T="int?" @bind-Value="Model.DefaultRecipeId"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               HelperText="@(L["dialog.productFieldDefaultRecipeHint"])">
                        <MudSelectItem T="int?" Value="@((int?)null)">@L["dialog.selectNone"]</MudSelectItem>
                        @foreach (var r in _allRecipes)
                        {
                            <MudSelectItem T="int?" Value="@((int?)r.Id)">
                                @r.Name @(string.IsNullOrEmpty(r.Description) ? "" : $"— {r.Description}")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <label class="vms-toggle">
                    <input type="checkbox" checked="@Model.IsActive" @onchange="@(e => Model.IsActive = e.Value is true)" />
                    <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                    <span class="vms-toggle-label">@L["status.active"]</span>
                </label>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn">
            @L["action.cancel"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Class="vms-btn">
            @(IsEdit ? L["action.update"] : L["action.create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ProductDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private List<RecipeDto> _allRecipes = new();

    protected override async Task OnInitializedAsync()
    {
        // 모든 클라이언트의 레시피를 합쳐서 보여줌 (제품은 라인 무관)
        var clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
        foreach (var c in clients)
        {
            var recipes = await Api.GetAsync<List<RecipeDto>>($"/api/clients/{c.Id}/recipes") ?? new();
            _allRecipes.AddRange(recipes);
        }
        _allRecipes = _allRecipes.DistinctBy(r => r.Id).OrderBy(r => r.Name).ToList();
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(Model));
    private void Cancel() => MudDialog.Cancel();
}
