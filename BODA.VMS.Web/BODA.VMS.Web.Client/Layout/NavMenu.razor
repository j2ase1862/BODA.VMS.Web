@inject Blazored.LocalStorage.ILocalStorageService Storage
@inject ILocalizer L
@implements IDisposable

@* 모바일(md 미만) 드로어 전용 내비 — 데스크톱은 TopNav(상단 pill)가 담당 (3a, 2026-08-12).
   메뉴 정의는 NavMenuItems 공유 목록 — TopNav와 동일한 Href·권한·i18n 키. *@
<MudNavMenu>
    @foreach (var g in NavMenuItems.Groups)
    {
        if (g.Roles is null)
        {
            @NavGroup(g)
        }
        else
        {
            <AuthorizeView Roles="@g.Roles">
                <Authorized>@NavGroup(g)</Authorized>
            </AuthorizeView>
        }
    }
</MudNavMenu>

@code {
    [Parameter]
    public Action? OnNavClick { get; set; }

    private RenderFragment NavGroup(NavGroupDef g) => __builder =>
    {
        <MudNavGroup Title="@L[g.TitleKey]" Icon="@g.Icon"
                     Expanded="_expanded.GetValueOrDefault(g.Key)"
                     ExpandedChanged="@(v => OnExpandedChanged(g.Key, v))">
            @foreach (var item in g.Items)
            {
                if (item.Roles is null)
                {
                    @ItemLink(item)
                }
                else
                {
                    <AuthorizeView Roles="@item.Roles">
                        <Authorized>@ItemLink(item)</Authorized>
                    </AuthorizeView>
                }
            }
        </MudNavGroup>
    };

    private RenderFragment ItemLink(NavItemDef item) => __builder =>
    {
        <MudNavLink Href="@item.Href"
                    Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                    Target="@(item.NewTab ? "_blank" : null)"
                    Icon="@item.Icon" OnClick="HandleClick">
            @L[item.TitleKey]@(item.NewTab ? " ↗" : "")
        </MudNavLink>
    };

    private Dictionary<string, bool> _expanded = new()
    {
        ["monitoring"] = true,
        ["production"] = true,
        ["quality"] = false,
        ["equipment"] = false,
        ["admin"] = false
    };

    private const string StorageKey = "vms_navmenu_expanded";

    protected override void OnInitialized()
    {
        L.OnLanguageChanged += HandleLangChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await Storage.GetItemAsync<Dictionary<string, bool>>(StorageKey);
            if (saved is not null && saved.Count > 0)
            {
                foreach (var (k, v) in saved)
                    if (_expanded.ContainsKey(k)) _expanded[k] = v;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task OnExpandedChanged(string key, bool expanded)
    {
        _expanded[key] = expanded;
        try { await Storage.SetItemAsync(StorageKey, _expanded); } catch { }
    }

    private async void HandleLangChanged() => await InvokeAsync(StateHasChanged);

    private void HandleClick() => OnNavClick?.Invoke();

    public void Dispose() => L.OnLanguageChanged -= HandleLangChanged;
}
