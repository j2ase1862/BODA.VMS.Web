<CascadingAuthenticationState>
    <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
        <CascadingValue Value="ToggleDarkMode" Name="ToggleDarkMode">
            <Router AppAssembly="typeof(Program).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                        <NotAuthorized>
                            <BODA.VMS.Web.Client.Pages.Login />
                        </NotAuthorized>
                        <Authorizing>
                            <div style="display:flex; align-items:center; justify-content:center; min-height:60vh;">
                                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                            </div>
                        </Authorizing>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <LayoutView Layout="typeof(Layout.MainLayout)">
                        <div class="pa-8 d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large"
                                     Style="color: var(--vms-text-secondary); opacity: 0.4;" Class="mb-3" />
                            <MudText Typo="Typo.h6" Style="color: var(--vms-text-secondary);">404 — Page Not Found</MudText>
                        </div>
                    </LayoutView>
                </NotFound>
            </Router>

            @* 팝오버/다이얼로그 콘텐츠는 이 프로바이더 하위에서 렌더된다 —
               내부의 AuthorizeView가 인증 캐스케이드를 받도록 반드시
               CascadingAuthenticationState 안쪽에 둘 것 (TopNav 드롭다운 권한 게이트, 2026-08-12) *@
            <MudPopoverProvider />
            @* 8b — 모든 다이얼로그 우측 상단 ✕ (README CRUD 공통) *@
            <MudDialogProvider CloseButton="true" />
            <MudSnackbarProvider />
        </CascadingValue>
    </CascadingValue>
</CascadingAuthenticationState>

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />

@code {
    private bool _isDarkMode = false;

    [Inject] private Blazored.LocalStorage.ILocalStorageService LocalStorage { get; set; } = null!;

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await LocalStorage.SetItemAsync("darkMode", _isDarkMode);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await LocalStorage.GetItemAsync<bool?>("darkMode");
            if (saved.HasValue && saved.Value != _isDarkMode)
            {
                _isDarkMode = saved.Value;
                StateHasChanged();
            }
        }
    }

    // "Machined Instrument" 테마 (2026-08-11) — VASIM CI 유지, 오렌지는 신호색으로 절제.
    // 라이트 = 엔지니어링 페이퍼(웜 그레이), 다크 = 네이비 잉크. 서체 Saira + IBM Plex Mono.
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#FF6724",
            Secondary = "#01397D",
            Tertiary = "#00264C",
            Background = "#F2F3F1",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#131A24",
            DrawerBackground = "#00264C",
            DrawerText = "rgba(255,255,255,0.72)",
            DrawerIcon = "rgba(255,255,255,0.72)",
            TextPrimary = "#131A24",
            TextSecondary = "#5C6470",
            ActionDefault = "#5C6470",
            Success = "#1F7A33",
            Error = "#C9342B",
            Warning = "#B75E00",
            Info = "#01397D",
            Divider = "#DCDFE3",
            TableLines = "#ECEDEA",
            LinesDefault = "#DCDFE3",
            LinesInputs = "#C9CDD3",
            HoverOpacity = 0.04
        },
        // 3a 소프트 다크 — design_handoff_boda_vms_redesign/README.md 의 Design Tokens 를
        // 그대로 사용 (임의 색 금지). 라이트 팔레트는 기존 값 유지 (README 지침).
        PaletteDark = new PaletteDark
        {
            Primary = "#FF7A3D",                        // 액션/활성 (CI 오렌지)
            PrimaryContrastText = "#0C121D",            // 오렌지 버튼 텍스트
            Secondary = "#5B9BE0",                      // 링크/식별자 (블루)
            Tertiary = "#5B9BE0",                       // 사용처 없음 — 블루 계열로 정합 (2026-08-12 지시)
            Background = "#0C121D",                     // 페이지 배경 (네이비 잉크)
            Surface = "#151E2E",                        // 카드/서피스
            AppbarBackground = "#0C121D",               // 공통 셸 상단바
            AppbarText = "#E6ECF5",
            DrawerBackground = "#0C121D",
            DrawerText = "#8C96A6",                     // 비활성 메뉴 톤
            DrawerIcon = "#8C96A6",
            TextPrimary = "#E6ECF5",                    // 주 텍스트
            TextSecondary = "#8C96A6",                  // 3차 텍스트/라벨
            ActionDefault = "#8C96A6",
            Success = "#3DD068",                        // 양품/정상
            Error = "#F0564C",                          // NG/오류
            Warning = "#E0A32E",                        // 경고
            Info = "#5B9BE0",
            Divider = "rgba(255,255,255,.07)",          // 구분선 (헤더)
            TableLines = "rgba(255,255,255,.04)",       // 구분선 (행)
            LinesDefault = "rgba(255,255,255,.05)",     // 카드 테두리
            LinesInputs = "rgba(255,255,255,.1)",       // 입력 테두리
            HoverOpacity = 0.06
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",               // 입력/버튼 radius (README 간격·형태)
            DrawerWidthLeft = "240px",
            DrawerMiniWidthLeft = "56px"
        },
        Typography = new Typography
        {
            Default = new Default
            {
                FontFamily = new[] { "Saira", "Malgun Gothic", "Apple SD Gothic Neo", "sans-serif" },
                FontSize = "0.875rem"
            },
            H4 = new H4
            {
                FontFamily = new[] { "Saira", "Malgun Gothic", "sans-serif" },
                FontWeight = 700,
                FontSize = "1.35rem"
            },
            H5 = new H5
            {
                FontFamily = new[] { "Saira", "Malgun Gothic", "sans-serif" },
                FontWeight = 600,
                FontSize = "1.15rem"
            },
            H6 = new H6
            {
                FontFamily = new[] { "Saira", "Malgun Gothic", "sans-serif" },
                FontWeight = 600,
                FontSize = "1rem"
            },
            Subtitle1 = new Subtitle1
            {
                FontFamily = new[] { "Saira", "Malgun Gothic", "sans-serif" },
                FontWeight = 600,
                FontSize = "0.85rem"
            }
        }
    };
}
