@page "/shifts"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject ILocalizer L

<PageTitle>@L["page.shifts"] - BODA VMS</PageTitle>

@* 8a CRUD 패턴 적용 — 헤더 부제, 필터 바 우측 끝 등록 *@
<div class="vms-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="vms-page-title">@L["page.shifts"]</MudText>
        <div class="vms-page-sub">@L.Format("shift.totalCountFmt", _items.Count)</div>
    </div>
</div>

<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <label class="vms-toggle" style="margin-bottom:10px;">
            <input type="checkbox" checked="@_showInactive" @onchange="OnShowInactiveChanged" />
            <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
            <span class="vms-toggle-label">@L["common.showInactive"]</span>
        </label>
        <div class="vms-filter-spacer"></div>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                   Variant="Variant.Filled" OnClick="OpenCreateDialog" Class="vms-btn">
            @L["shift.btnCreate"]
        </MudButton>
    </div>
</MudPaper>

<div class="vms-table">
    <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0">
        <HeaderContent>
            <MudTh>@L["shift.colName"]</MudTh>
            <MudTh>@L["common.time"]</MudTh>
            <MudTh Style="text-align:right;">@L["common.duration"]</MudTh>
            <MudTh>@L["common.status"]</MudTh>
            <MudTh Style="text-align:right;">@L["common.actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span style="font-weight:500;">@context.Name</span></MudTd>
            <MudTd>
                <span class="vms-mono">@context.TimeRange</span>
            </MudTd>
            <MudTd Style="text-align:right;">
                <span class="vms-mono">@context.DurationHours h</span>
            </MudTd>
            <MudTd>
                <span class="vms-wo-chip @(context.IsActive ? "st-done" : "st-flat")">
                    @(context.IsActive ? L["status.active"] : L["status.inactive"])
                </span>
            </MudTd>
            <MudTd Style="text-align:right; white-space:nowrap;">
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                           OnClick="@(() => OpenEditDialog(context))">@L["workorder.actEdit"]</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                           OnClick="@(() => DeleteItem(context))">@L["workorder.actDelete"]</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="vms-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" />
                <span class="vms-empty-text">@L["shift.noShifts"]</span>
            </div>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    private List<ShiftDto> _items = new();
    private bool _loading;
    private bool _showInactive;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _items = await Api.GetAsync<List<ShiftDto>>(
            $"/api/shifts?includeInactive={_showInactive}") ?? new();
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ShiftFormDialog>
        {
            { x => x.Model, new ShiftDto { StartHour = 8, EndHour = 16, IsActive = true } },
            { x => x.IsEdit, false }
        };
        var dialog = await Dialog.ShowAsync<ShiftFormDialog>(L["shift.createTitle"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (ShiftDto)result.Data!;
                await Api.PostAsync<ShiftDto, ShiftDto>("/api/shifts", dto);
                Snackbar.Add(L.Format("shift.createdFmt", dto.Name), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(ShiftDto src)
    {
        var copy = new ShiftDto
        {
            Id = src.Id, Name = src.Name,
            StartHour = src.StartHour, EndHour = src.EndHour, IsActive = src.IsActive
        };
        var parameters = new DialogParameters<ShiftFormDialog>
        {
            { x => x.Model, copy },
            { x => x.IsEdit, true }
        };
        var dialog = await Dialog.ShowAsync<ShiftFormDialog>(L.Format("shift.editTitleFmt", src.Name), parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (ShiftDto)result.Data!;
                await Api.PutAsync<ShiftDto, ShiftDto>($"/api/shifts/{src.Id}", dto);
                Snackbar.Add(L.Format("shift.updatedFmt", dto.Name), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OnShowInactiveChanged(ChangeEventArgs e)
    {
        _showInactive = e.Value is true;
        await Load();
    }

    private async Task DeleteItem(ShiftDto s)
    {
        // 8b 파괴적 확인 — 대상 식별자 모노 명시
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, s.Name },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["confirm.delete"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;
        try
        {
            await Api.DeleteAsync($"/api/shifts/{s.Id}");
            Snackbar.Add(L.Format("shift.deletedFmt", s.Name), Severity.Warning);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }
}
