@page "/register"
@layout BODA.VMS.Web.Client.Layout.EmptyLayout
@inject ApiClient Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILocalizer L

<PageTitle>@L["page.register"] - BODA VMS</PageTitle>

<div class="vms-login-bg">
    <MudCard Class="vms-login-card pa-8">
        <MudCardContent>
            <div class="vms-login-logo mb-1">
                <span class="navy">BODA</span> <span class="orange">VMS</span>
            </div>
            <div class="vms-login-subtitle mb-2">Create Account</div>
            <MudText Typo="Typo.body2" Align="Align.Center" Style="color: var(--vms-text-light); font-size: 0.8rem;"
                     Class="mb-6">
                Your account will require admin approval before access is granted.
            </MudText>

            <EditForm Model="_model" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.Username" Label="Username"
                              Variant="Variant.Outlined" Class="mb-4"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              For="@(() => _model.Username)" />

                <MudTextField @bind-Value="_model.DisplayName" Label="Display Name"
                              Variant="Variant.Outlined" Class="mb-4"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Badge"
                              For="@(() => _model.DisplayName)" />

                <MudTextField @bind-Value="_model.Password" Label="Password"
                              Variant="Variant.Outlined" Class="mb-6"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              For="@(() => _model.Password)"
                              HelperText="8+ chars with upper/lower/digit/special (3 types), or 10+ chars (2 types)" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Color="Color.Primary" FullWidth="true" Disabled="_loading"
                           Size="Size.Large" Class="vms-btn mb-4">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Register
                </MudButton>
            </EditForm>

            <div class="d-flex justify-center">
                <MudLink Href="/login" Typo="Typo.body2" Color="Color.Secondary">
                    Already have an account? Sign In
                </MudLink>
            </div>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private RegisterRequest _model = new();
    private bool _loading;

    private async Task HandleRegister()
    {
        _loading = true;
        try
        {
            var response = await Api.PostWithResponseAsync("/api/auth/register", _model);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Registration successful! Please wait for admin approval.", Severity.Success);
                Navigation.NavigateTo("/login");
                return;
            }

            // 400 은 두 형태 — {message} (중복 사용자명) 또는 ValidationProblemDetails
            // (비밀번호 정책 등). 기존에는 모든 400 을 "Username already exists" 로
            // 표시해 실제 사유(주로 비밀번호 복잡도)를 알 수 없었다 (2026-08-11 수정).
            var reason = await ExtractErrorAsync(response);
            Snackbar.Add(reason ?? "Registration failed. Please try again.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("Registration failed. Please try again.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static async Task<string?> ExtractErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var json = await response.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            // ValidationProblemDetails: { "errors": { "Field": ["msg", ...] } }
            if (root.TryGetProperty("errors", out var errors)
                && errors.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                var messages = new List<string>();
                foreach (var field in errors.EnumerateObject())
                    foreach (var msg in field.Value.EnumerateArray())
                        if (msg.GetString() is { Length: > 0 } s) messages.Add(s);
                if (messages.Count > 0) return string.Join(" / ", messages);
            }

            // 엔드포인트 커스텀 형태: { "message": "..." }
            if (root.TryGetProperty("message", out var m) && m.GetString() is { Length: > 0 } text)
                return text;
        }
        catch { /* 본문이 JSON 이 아니면 기본 메시지 */ }
        return null;
    }
}
