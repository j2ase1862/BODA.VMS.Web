@page "/workorders"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject ILocalizer L
@inject SignalRService SignalR

<PageTitle>@L["page.workorders"] - BODA VMS</PageTitle>

@* 8a — CRUD 기준 화면: 헤더 부제는 의미 있는 요약, 등록 버튼은 필터 바 우측 끝 *@
<div class="vms-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="vms-page-title">@L["page.workorders"]</MudText>
        <div class="vms-page-sub">
            @L.Format("workorder.subCountFmt", CountOf("InProgress"), CountOf("Planned"))
        </div>
    </div>
</div>

<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.status"]</label>
            <MudSelect T="string?" Value="_statusFilter" ValueChanged="OnStatusFilterChanged" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string?" Value="@((string?)null)">@L["common.all"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Planned")">@L["status.planned"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("InProgress")">@L["status.inProgress"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Completed")">@L["status.completed"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Closed")">@L["status.closed"]</MudSelectItem>
            </MudSelect>
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.line"]</label>
            <MudSelect T="int?" Value="_clientFilter" ValueChanged="OnClientFilterChanged" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["common.all"]</MudSelectItem>
                @foreach (var c in _clients)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">
                        #@c.ClientIndex.ToString("D2") — @c.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-spacer"></div>
        <AuthorizeView Roles="Admin,User">
            <Authorized>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                           Variant="Variant.Filled" OnClick="OpenCreateDialog" Class="vms-btn">
                    @L["workorder.btnCreate"]
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </div>
</MudPaper>

<div class="vms-table">
    <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0">
        <HeaderContent>
            <MudTh>@L["workorder.colOrderNo"]</MudTh>
            <MudTh>@L["common.product"]</MudTh>
            <MudTh>@L["common.line"]</MudTh>
            <MudTh>@L["common.recipe"]</MudTh>
            <MudTh Style="text-align: right;">@L["workorder.colPlannedQty"]</MudTh>
            <MudTh Style="text-align: right;">@L["workorder.colProducedQty"]</MudTh>
            <MudTh Style="text-align: right;">@L["workorder.colPassNg"]</MudTh>
            <MudTh>@L["workorder.colProgress"]</MudTh>
            <MudTh>@L["common.status"]</MudTh>
            <MudTh Style="text-align: right;">@L["common.actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <span class="vms-cell-id">@context.OrderNo</span>
            </MudTd>
            <MudTd>
                <div class="vms-cell-title">@context.ProductCode</div>
                <div class="vms-cell-msg">@context.ProductName</div>
            </MudTd>
            <MudTd>
                @if (context.ClientIndex.HasValue)
                {
                    <span class="vms-mono-dim">#@context.ClientIndex.Value.ToString("D2")</span>
                    <span style="font-size:12.5px;"> @context.ClientName</span>
                }
                else { <span class="vms-cell-empty">—</span> }
            </MudTd>
            <MudTd><span class="vms-mono-dim">@context.RecipeName</span></MudTd>
            <MudTd Style="text-align: right;"><span class="vms-mono">@context.PlannedQuantity.ToString("N0")</span></MudTd>
            <MudTd Style="text-align: right;"><span class="vms-mono">@context.ProducedQuantity.ToString("N0")</span></MudTd>
            <MudTd Style="text-align: right;">
                @* 양품/NG 합성 셀 — 저채도 (README 8a) *@
                <span class="vms-qty-pass">@context.PassQuantity.ToString("N0")</span><span class="vms-qty-sep"> / </span><span class="vms-qty-ng">@context.NgQuantity.ToString("N0")</span>
            </MudTd>
            <MudTd>
                <div class="vms-wo-prog">
                    <div class="vms-wo-prog-track">
                        <div class="vms-wo-prog-fill @ProgClass(context)"
                             style="width:@Math.Min(context.Progress, 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <span class="vms-wo-prog-pct">@context.Progress.ToString("F1")%</span>
                </div>
            </MudTd>
            <MudTd>
                <span class="vms-wo-chip @StatusClass(context.Status)">@StatusLabel(context.Status, L)</span>
            </MudTd>
            <MudTd Style="text-align: right; white-space: nowrap;">
                @* 전이는 모노 아웃라인 버튼 + 짧은 텍스트 라벨(아이콘 금지 — 현장 오조작 방지) *@
                <AuthorizeView Roles="Admin,User">
                    <Authorized Context="auth1">
                        @if (context.Status == "Planned")
                        {
                            <button type="button" class="vms-act-btn start"
                                    @onclick="@(() => ChangeStatus(context, "Start"))">@L["workorder.btnStart"]</button>
                        }
                        else if (context.Status == "InProgress")
                        {
                            <button type="button" class="vms-act-btn done"
                                    @onclick="@(() => ChangeStatus(context, "Complete"))">@L["workorder.btnComplete"]</button>
                        }
                        else if (context.Status == "Completed")
                        {
                            <button type="button" class="vms-act-btn close"
                                    @onclick="@(() => ChangeStatus(context, "Close"))">@L["workorder.btnClose"]</button>
                        }
                        <button type="button" class="vms-act-btn lot"
                                @onclick="@(() => OpenLots(context))">LOT</button>
                        @if (context.Status == "Planned")
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                       OnClick="@(() => OpenEditDialog(context))">@L["workorder.actEdit"]</MudButton>
                        }
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Admin">
                    <Authorized Context="auth2">
                        @if (context.Status == "Planned")
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                                       OnClick="@(() => DeleteItem(context))">@L["workorder.actDelete"]</MudButton>
                        }
                    </Authorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            @* 8b 빈 상태 패턴 — 아웃라인 아이콘 + 저조도 안내문, 컬러 금지 *@
            <div class="vms-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Assignment" />
                <span class="vms-empty-text">@L["workorder.noOrders"]</span>
            </div>
        </NoRecordsContent>
    </MudTable>
    <div class="vms-slots-info">@L["workorder.transitionHint"]</div>
</div>

@code {
    private List<WorkOrderDto> _items = new();
    private List<ClientDto> _clients = new();
    private bool _loading;
    private string? _statusFilter;
    private int? _clientFilter;

    private int CountOf(string status) => _items.Count(w => w.Status == status);

    protected override async Task OnInitializedAsync()
    {
        // 실시간: VMS 결과 업로드/수동 상태 변경의 WO 진행 브로드캐스트를 즉시 반영
        // (기존에는 페이지 재진입/F5 전까지 수량이 갱신되지 않았음 — 2026-08-21 현장)
        SignalR.OnWorkOrderUpdated += HandleWoProgress;
        SignalR.OnWorkOrderCompleted += HandleWoProgress;
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
        await Load();
    }

    private async void HandleWoProgress(WorkOrderProgressDto dto) => await InvokeAsync(() =>
    {
        // 현재 목록에 있는 행만 제자리 갱신 — 필터 밖 WO 는 무시 (필터 존중).
        // 상태가 바뀌어 필터와 어긋난 행은 다음 Load 까지 유지 — 완료 전환을 눈으로 볼 수 있어 의도적.
        var row = _items.FirstOrDefault(w => w.Id == dto.Id);
        if (row is null) return;

        row.ProducedQuantity = dto.ProducedQuantity;
        row.PassQuantity = dto.PassQuantity;
        row.NgQuantity = dto.NgQuantity;
        row.Status = dto.Status;
        row.CompletionBasis = dto.CompletionBasis;
        foreach (var item in dto.Items)
        {
            var line = row.Items.FirstOrDefault(i => i.RecipeId == item.RecipeId);
            if (line is null) continue;
            line.ProducedQty = item.ProducedQty;
            line.PassQty = item.PassQty;
            line.NgQty = item.NgQty;
        }
        StateHasChanged();
    });

    public void Dispose()
    {
        SignalR.OnWorkOrderUpdated -= HandleWoProgress;
        SignalR.OnWorkOrderCompleted -= HandleWoProgress;
    }

    private async Task Load()
    {
        _loading = true;
        var q = new List<string>();
        if (!string.IsNullOrEmpty(_statusFilter)) q.Add($"status={_statusFilter}");
        if (_clientFilter.HasValue) q.Add($"clientId={_clientFilter}");
        var url = "/api/workorders" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
        _items = await Api.GetAsync<List<WorkOrderDto>>(url) ?? new();
        _loading = false;
    }

    private async Task OnStatusFilterChanged(string? s) { _statusFilter = s; await Load(); }
    private async Task OnClientFilterChanged(int? id) { _clientFilter = id; await Load(); }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<WorkOrderFormDialog>
        {
            { x => x.Model, new WorkOrderDto { PlannedQuantity = 100 } },
            { x => x.IsEdit, false }
        };
        var dialog = await Dialog.ShowAsync<WorkOrderFormDialog>(L["workorder.btnCreate"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (WorkOrderDto)result.Data!;
                var created = await Api.PostAsync<WorkOrderDto, WorkOrderDto>("/api/workorders", dto);
                Snackbar.Add(L.Format("workorder.createdFmt", created?.OrderNo ?? ""), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(WorkOrderDto src)
    {
        var copy = new WorkOrderDto
        {
            Id = src.Id,
            OrderNo = src.OrderNo,
            ProductId = src.ProductId,
            ClientId = src.ClientId,
            RecipeId = src.RecipeId,
            PlannedQuantity = src.PlannedQuantity,
            Status = src.Status,
            CompletionBasis = src.CompletionBasis,
            PlannedStartAt = src.PlannedStartAt,
            Note = src.Note,
            Items = src.Items.Select(i => new WorkOrderItemDto
            {
                Id = i.Id,
                RecipeId = i.RecipeId,
                RecipeName = i.RecipeName,
                PlannedQty = i.PlannedQty,
                ProducedQty = i.ProducedQty,
                PassQty = i.PassQty,
                NgQty = i.NgQty
            }).ToList()
        };
        var parameters = new DialogParameters<WorkOrderFormDialog>
        {
            { x => x.Model, copy },
            { x => x.IsEdit, true }
        };
        var dialog = await Dialog.ShowAsync<WorkOrderFormDialog>(L.Format("workorder.editTitleFmt", src.OrderNo), parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (WorkOrderDto)result.Data!;
                await Api.PutAsync<WorkOrderDto, WorkOrderDto>($"/api/workorders/{src.Id}", dto);
                Snackbar.Add(L.Format("workorder.updatedFmt", dto.OrderNo), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task ChangeStatus(WorkOrderDto wo, string action)
    {
        var actionLabel = action switch
        {
            "Start" => L["workorder.actStart"],
            "Complete" => L["workorder.actComplete"],
            "Close" => L["workorder.actClose"],
            _ => action
        };
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, wo.OrderNo },
            { x => x.Message, L.Format("confirm.actionFmt", actionLabel) },
            { x => x.ConfirmText, actionLabel }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["action.confirm"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await Api.PostAsync<WorkOrderStatusChangeRequest, WorkOrderDto>(
                $"/api/workorders/{wo.Id}/status",
                new WorkOrderStatusChangeRequest { Action = action });
            Snackbar.Add(L.Format("workorder.transitionFmt", wo.OrderNo, actionLabel), Severity.Success);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private async Task OpenLots(WorkOrderDto wo)
    {
        var parameters = new DialogParameters<LotListDialog>
        {
            { x => x.WorkOrderId, wo.Id },
            { x => x.WorkOrderNo, wo.OrderNo }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = false };
        var dialog = await Dialog.ShowAsync<LotListDialog>(L.Format("workorder.lotsTitleFmt", wo.OrderNo), parameters, options);
        await dialog.Result;
        await Load();
    }

    private async Task DeleteItem(WorkOrderDto wo)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, wo.OrderNo },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["confirm.delete"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await Api.DeleteAsync($"/api/workorders/{wo.Id}");
            Snackbar.Add(L.Format("workorder.deletedFmt", wo.OrderNo), Severity.Warning);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private static string StatusLabel(string s, ILocalizer L) => s switch
    {
        "Planned" => L["status.planned"],
        "InProgress" => L["status.inProgress"],
        "Completed" => L["status.completed"],
        "Closed" => L["status.closed"],
        _ => s
    };

    // 상태 칩 — 채움은 '지금 진행 중' 하나만 (README 8a)
    private static string StatusClass(string status) => status switch
    {
        "InProgress" => "st-run",
        "Completed" => "st-done",
        _ => "st-flat"
    };

    // 진행률 바 — 100% 완료 그린 / 진행 중 블루 / 미착수 회색
    private static string ProgClass(WorkOrderDto wo)
    {
        if (wo.Progress >= 100) return "done";
        if (wo.Status == "InProgress") return "run";
        return "none";
    }
}
