@page "/login"
@layout BODA.VMS.Web.Client.Layout.EmptyLayout
@inject ApiClient Api
@inject AuthStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILocalizer L
@inject Blazored.LocalStorage.ILocalStorageService Storage

<PageTitle>@L["page.login"] - BODA VMS</PageTitle>

@* 4a — 로그인. 배경/카드/십자 장식은 app.css .vms-login-* (테마 무관 다크 고정).
   라벨은 필드 위 외부 라벨(모노 10px .14em uppercase) — floating label 미사용 (README 4a). *@
<div class="vms-login-bg">
    <MudCard Class="vms-login-card">
        <MudCardContent Class="vms-login-content">
            <div class="vms-login-logo mb-1">
                @* "orange"는 MudBlazor 팔레트 헬퍼(배경 #FF9800)와 충돌 — accent 로 명명 *@
                <span class="navy">BODA</span> <span class="accent">VMS</span>
            </div>
            <div class="vms-login-subtitle mb-8">Vision Management System</div>

            <EditForm Model="_model" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="vms-login-field">
                    <label class="vms-field-label" for="login-username">@L["login.username"]</label>
                    <MudTextField @bind-Value="_model.Username"
                                  Variant="Variant.Outlined" Class="vms-login-input"
                                  InputId="login-username"
                                  For="@(() => _model.Username)" />
                </div>

                <div class="vms-login-field">
                    <label class="vms-field-label" for="login-password">@L["login.password"]</label>
                    <MudTextField @bind-Value="_model.Password"
                                  Variant="Variant.Outlined" Class="vms-login-input"
                                  InputId="login-password"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                  For="@(() => _model.Password)" />
                </div>

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Color="Color.Primary" FullWidth="true" Disabled="_loading"
                           Class="vms-btn vms-login-submit">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @L["login.signIn"]
                </MudButton>
            </EditForm>

            <div class="vms-login-register">
                <MudLink Href="/register" Class="vms-login-register-link">@L["login.noAccount"]</MudLink>
            </div>

            <div class="vms-login-footer">
                @_versionLabel · @L["login.footerNote"]
            </div>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private LoginRequest _model = new();
    private bool _loading;
    private bool _showPassword;

    private static readonly string _versionLabel = "VMS " +
        (typeof(Login).Assembly
            .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
            .OfType<System.Reflection.AssemblyInformationalVersionAttribute>()
            .FirstOrDefault()?.InformationalVersion?.Split('+')[0] ?? "1.0.0");

    private async Task HandleLogin()
    {
        _loading = true;
        try
        {
            var response = await Api.PostAsync<LoginRequest, LoginResponse>("/api/auth/login", _model);
            if (response is not null)
            {
                await AuthProvider.LoginAsync(response);
                if (response.MustChangePassword)
                {
                    // 임시 비밀번호 상태 — 비밀번호 변경 완료 전까지 다른 화면 차단
                    // (MainLayout 이 이 플래그를 보고 /change-password 로 리다이렉트)
                    await Storage.SetItemAsync("vms_must_change_pw", true);
                    Navigation.NavigateTo("/change-password", forceLoad: true);
                }
                else
                {
                    Navigation.NavigateTo("/", forceLoad: true);
                }
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Snackbar.Add(L["login.invalidCreds"], Severity.Error);
        }
        catch
        {
            Snackbar.Add(L["login.failed"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
