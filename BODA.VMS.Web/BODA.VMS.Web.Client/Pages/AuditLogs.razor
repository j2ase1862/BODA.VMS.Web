@page "/audit-logs"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

<PageTitle>@L["page.auditLogs"] - BODA VMS</PageTitle>

@* 8a 패턴 적용 — INFO 배너 + 4b 필터 바 *@
<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.auditLogs"]</MudText>

<div class="vms-banner info mb-4">
    <span class="vms-banner-label">INFO</span>
    <span class="vms-banner-text">@L["audit.alertInfo"]</span>
</div>

<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["audit.filterEntity"]</label>
            <MudSelect T="string?" @bind-Value="_entityName" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string?" Value="@((string?)null)">@L["common.all"]</MudSelectItem>
                @foreach (var n in _entities)
                {
                    <MudSelectItem T="string?" Value="@((string?)n)">@n</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["audit.filterAction"]</label>
            <MudSelect T="string?" @bind-Value="_action" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string?" Value="@((string?)null)">@L["common.all"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Create")">@L["audit.actionCreate"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Update")">@L["audit.actionUpdate"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Delete")">@L["audit.actionDelete"]</MudSelectItem>
            </MudSelect>
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.startDate"]</label>
            <MudDatePicker @bind-Date="_startDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.endDate"]</label>
            <MudDatePicker @bind-Date="_endDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="Load" Class="vms-btn">@L["action.search"]</MudButton>
    </div>
</MudPaper>

<div class="vms-table">
    <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0">
        <HeaderContent>
            <MudTh>@L["audit.colTimestamp"]</MudTh>
            <MudTh>@L["audit.colUser"]</MudTh>
            <MudTh>@L["audit.colAction"]</MudTh>
            <MudTh>@L["audit.colEntity"]</MudTh>
            <MudTh>@L["audit.colEntityId"]</MudTh>
            <MudTh>@L["audit.colChanges"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <span class="vms-mono-dim">@context.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
            </MudTd>
            <MudTd>
                @if (context.UserId.HasValue)
                {
                    <div class="vms-cell-title" style="font-weight:500;">@context.UserName</div>
                    <div class="vms-cell-when">id=@context.UserId @(context.IpAddress is null ? "" : $"· {context.IpAddress}")</div>
                }
                else { <span class="vms-cell-empty">@L["audit.system"]</span> }
            </MudTd>
            <MudTd>
                <span class="vms-state-chip @ActionClass(context.Action)">@ActionLabel(context.Action, L)</span>
            </MudTd>
            <MudTd><span style="font-weight:500;">@context.EntityName</span></MudTd>
            <MudTd><span class="vms-cell-id w500">@context.EntityId</span></MudTd>
            <MudTd>
                @if (!string.IsNullOrEmpty(context.Changes))
                {
                    <pre style="font-family: var(--vms-font-mono); font-size:11px; max-width: 500px; max-height: 100px; overflow:auto; background: #0C121D; border: 1px solid var(--vms-hairline); padding: 6px 8px; border-radius: 6px; margin: 0; color: var(--mud-palette-text-secondary);">@context.Changes</pre>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="vms-empty">
                <MudIcon Icon="@Icons.Material.Outlined.FactCheck" />
                <span class="vms-empty-text">@L["audit.noData"]</span>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</div>

@code {
    private List<AuditLogDto> _items = new();
    private List<string> _entities = new();
    private bool _loading;
    private string? _entityName;
    private string? _action;
    private DateTime? _startDate = DateTime.Today.AddDays(-7);
    private DateTime? _endDate = DateTime.Today.AddDays(1);

    protected override async Task OnInitializedAsync()
    {
        try { _entities = await Api.GetAsync<List<string>>("/api/audit-logs/entity-names") ?? new(); } catch { }
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var q = new List<string> { "pageSize=100" };
        if (!string.IsNullOrEmpty(_entityName)) q.Add($"entityName={_entityName}");
        if (!string.IsNullOrEmpty(_action)) q.Add($"action={_action}");
        if (_startDate.HasValue) q.Add($"startDate={_startDate.Value:yyyy-MM-ddTHH:mm:ss}");
        if (_endDate.HasValue) q.Add($"endDate={_endDate.Value:yyyy-MM-ddTHH:mm:ss}");
        var url = "/api/audit-logs?" + string.Join("&", q);

        try
        {
            var page = await Api.GetAsync<PagedResult<AuditLogDto>>(url);
            _items = page?.Items ?? new();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
        _loading = false;
    }

    private static string ActionLabel(string a, ILocalizer L) => a switch
    {
        "Create" => L["audit.actionCreate"],
        "Update" => L["audit.actionUpdate"],
        "Delete" => L["audit.actionDelete"],
        _ => a
    };

    // 상태 칩 — 생성 그린 / 수정 블루 / 삭제 레드 (기존 매핑 유지, 저채도)
    private static string ActionClass(string a) => a switch
    {
        "Create" => "st-res",
        "Update" => "st-ack",
        "Delete" => "st-new",
        _ => "st-ack"
    };
}
