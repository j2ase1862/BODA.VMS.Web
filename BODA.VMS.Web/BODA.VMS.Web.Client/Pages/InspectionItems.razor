@page "/inspection-items"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,User")]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject ILocalizer L

<PageTitle>@L["page.inspectionItems"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.inspectionItems"]</MudText>

@* 12a — 필터 바는 '선택 단계': 라인 → 레시피, 둘 다 필수(*). 우측 레시피 등록(보조, Admin) *@
<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field wide">
            <label class="vms-filter-label">@L["inspection.selectLine"]<span class="req" style="color:var(--vms-primary);">*</span></label>
            <MudSelect T="int?" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Value="_selectedClientId" ValueChanged="OnClientChanged"
                       ToStringFunc="@(id => id is null ? "" : _clients.FirstOrDefault(c => c.Id == id) is { } x ? $"#{x.ClientIndex:D2} — {x.Name}" : "")">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["inspection.lineSelectPlaceholder"]</MudSelectItem>
                @foreach (var client in _clients)
                {
                    <MudSelectItem T="int?" Value="@((int?)client.Id)">
                        #@client.ClientIndex.ToString("D2") — @client.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-field wide">
            <label class="vms-filter-label">@L["inspection.selectRecipe"]<span class="req" style="color:var(--vms-primary);">*</span></label>
            <MudSelect T="int?" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Value="_selectedRecipeId" ValueChanged="OnRecipeChanged"
                       Disabled="@(!_selectedClientId.HasValue)"
                       ToStringFunc="@(id => id is null ? "" : _recipes.FirstOrDefault(r => r.Id == id)?.Name ?? "")">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["inspection.recipeSelectPlaceholder"]</MudSelectItem>
                @foreach (var recipe in _recipes)
                {
                    <MudSelectItem T="int?" Value="@((int?)recipe.Id)">
                        @recipe.Name @(string.IsNullOrEmpty(recipe.Description) ? "" : $"— {recipe.Description}")
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-spacer"></div>
        @* 생성/수정/삭제는 Admin 전용 — User 는 조회만 (2026-08-11 정책) *@
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateRecipeDialog"
                           Disabled="@(!_selectedClientId.HasValue)"
                           Class="vms-btn">
                    @L["inspection.btnCreateRecipe"]
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </div>
</MudPaper>

@if (_selectedClientId.HasValue && !_selectedRecipeId.HasValue && _recipes.Count == 0)
{
    @* 레시피 없음 — 8b 빈 상태 패턴 + 주 액션 *@
    <MudPaper Class="vms-panel">
        <div class="vms-empty">
            <MudIcon Icon="@Icons.Material.Outlined.MenuBook" />
            <span class="vms-empty-text">@L["inspection.noRecipes"] — @L["inspection.noRecipesHint"]</span>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateRecipeDialog"
                               Class="vms-btn mt-2">
                        @L["inspection.btnCreateRecipe"]
                    </MudButton>
                </Authorized>
            </AuthorizeView>
        </div>
    </MudPaper>
}

@if (_selectedRecipeId.HasValue)
{
    <div class="vms-table">
        <MudTable Items="_params" Dense="true" Hover="true" Loading="_loading" Elevation="0"
                  GroupBy="_groupDefinition" GroupHeaderStyle="background-color: rgba(255,255,255,0.03);">
            <ToolBarContent>
                @* 12a 표 툴바 — 레시피명 15px/700 + 파라미터 수 모노, 우측 프리셋(보조)·항목 추가(오렌지)·
                   레시피 삭제(적 아웃라인 — 파괴적 액션은 항상 맨 오른쪽 끝) *@
                <div class="d-flex align-center flex-wrap gap-2" style="width: 100%;">
                    <MudText Class="vms-panel-header">
                        @(_recipes.FirstOrDefault(r => r.Id == _selectedRecipeId)?.Name ?? "")
                    </MudText>
                    <span class="vms-mono-dim" style="font-size:11px;">
                        @L.Format("inspection.totalCodesFmt", _params.Count)
                    </span>
                    <MudSpacer />
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               EndIcon="@Icons.Material.Filled.ArrowDropDown" Class="vms-btn">
                                        @L["inspection.btnPreset"]
                                    </MudButton>
                                </ActivatorContent>
                                <ChildContent>
                                    @foreach (var group in ParameterPresetGroup.PresetGroups)
                                    {
                                        <MudMenuItem OnClick="@(() => AddPresetGroup(group))">
                                            <span style="font-weight: 600;">@group.GroupName</span>
                                            <span style="color: var(--mud-palette-text-secondary); margin-left: 8px; font-size: 0.8rem;">
                                                (@group.Entries.Count)
                                            </span>
                                        </MudMenuItem>
                                    }
                                </ChildContent>
                            </MudMenu>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateDialog" Class="vms-btn">
                                @L["inspection.btnAddItem"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="DeleteSelectedRecipe" Class="vms-btn vms-btn-danger-outline">
                                @L["inspection.btnDeleteRecipe"]
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@L["inspection.colCode"]</MudTh>
                <MudTh>@L["inspection.colDescription"]</MudTh>
                <MudTh Style="text-align: right;">@L["inspection.colValue"]</MudTh>
                <MudTh>@L["common.status"]</MudTh>
                <MudTh Style="text-align: right;">@L["common.actions"]</MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                @* 분류 그룹 행 — 색칩 대신 그룹 행 자체가 구분자 (README 12a) *@
                <MudTd colspan="5" Style="padding: 8px 16px;">
                    <span style="font-weight: 600; font-size: 13px; color: var(--mud-palette-text-primary);">@context.Key</span>
                    <span class="vms-mono-dim" style="margin-left: 8px; font-size: 11px;">
                        @L.Format("inspection.categoryCountFmt", context.Items.Count())
                    </span>
                </MudTd>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd>
                    <span class="vms-cell-id">@context.ParamCode</span>
                </MudTd>
                <MudTd>
                    <div class="vms-cell-title" style="font-weight:500;">@context.Description</div>
                    @if (!string.IsNullOrEmpty(context.Unit))
                    {
                        <div class="vms-cell-when">@context.Unit</div>
                    }
                </MudTd>
                <MudTd Style="text-align: right;">
                    <span class="vms-mono">@context.ParamValue.ToString("F4")</span>
                </MudTd>
                <MudTd>
                    <span class="vms-wo-chip @(context.IsActive ? "st-done" : "st-flat")">
                        @(context.IsActive ? L["status.active"] : L["status.inactive"])
                    </span>
                </MudTd>
                <MudTd Style="text-align: right; white-space: nowrap;">
                    <AuthorizeView Roles="Admin">
                        <Authorized Context="authContext1">
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                       OnClick="@(() => OpenEditDialog(context))">@L["workorder.actEdit"]</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                                       OnClick="@(() => DeleteParam(context))">@L["workorder.actDelete"]</MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @* 파라미터 없음 — 8b 빈 상태 + 주 액션 *@
                <div class="vms-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" />
                    <span class="vms-empty-text">@L["inspection.noParams"] — @L["inspection.noParamsHint"]</span>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateDialog" Class="vms-btn mt-2">
                                @L["inspection.btnAddItem"]
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </NoRecordsContent>
        </MudTable>
        <div class="vms-slots-info">@L.Format("inspection.footerHintFmt", _nextCode?.ToString() ?? "—")</div>
    </div>
}

@code {
    private List<ClientDto> _clients = new();
    private List<RecipeDto> _recipes = new();
    private List<RecipeParameterDto> _params = new();
    private int? _selectedClientId;
    private int? _selectedRecipeId;
    private bool _loading;

    private TableGroupDefinition<RecipeParameterDto> _groupDefinition = new()
    {
        GroupName = "Category",
        Selector = item => item.Category,
        Expandable = true,
        IsInitiallyExpanded = true
    };

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
    }

    private async Task OnClientChanged(int? clientId)
    {
        _selectedClientId = clientId;
        _selectedRecipeId = null;
        _params = new();

        if (clientId.HasValue)
        {
            var client = _clients.FirstOrDefault(c => c.Id == clientId);
            if (client != null)
            {
                _recipes = await Api.GetAsync<List<RecipeDto>>(
                    $"/api/clients/{clientId.Value}/recipes") ?? new();
            }
        }
        else
        {
            _recipes = new();
        }
    }

    private async Task OnRecipeChanged(int? recipeId)
    {
        _selectedRecipeId = recipeId;
        if (recipeId.HasValue)
            await LoadParams();
        else
            _params = new();
    }

    private int? _nextCode;

    private async Task LoadParams()
    {
        if (!_selectedRecipeId.HasValue) return;
        _loading = true;
        _params = await Api.GetAsync<List<RecipeParameterDto>>(
            $"/api/parameters/recipe/{_selectedRecipeId.Value}") ?? new();
        _loading = false;
        // 표 하단 안내용 다음 자동 코드
        try { _nextCode = await GetNextCode(); } catch { _nextCode = null; }
    }

    private async Task<int> GetNextCode()
    {
        var resp = await Api.GetAsync<NextCodeResponse>(
            $"/api/parameters/next-code/{_selectedRecipeId!.Value}");
        return resp?.NextCode ?? 1;
    }

    private async Task AddPresetGroup(ParameterPresetGroup group)
    {
        var nextCode = await GetNextCode();
        var dtos = new List<RecipeParameterDto>();

        foreach (var entry in group.Entries)
        {
            dtos.Add(new RecipeParameterDto
            {
                RecipeId = _selectedRecipeId!.Value,
                ParamCode = nextCode++,
                ParamValue = 0,
                Description = entry.DescriptionTemplate,
                Category = group.Category,
                Unit = entry.Unit,
                IsActive = true
            });
        }

        // 미리보기 — 어떤 항목이 어떤 코드로 추가되는지 확인 후 진행
        var previewParams = new DialogParameters<PresetPreviewDialog> { { x => x.Items, dtos } };
        var previewDialog = await Dialog.ShowAsync<PresetPreviewDialog>(
            L.Format("inspection.presetPreviewTitleFmt", group.GroupName), previewParams);
        var previewResult = await previewDialog.Result;
        if (previewResult is null || previewResult.Canceled) return;

        try
        {
            await Api.PostAsync<List<RecipeParameterDto>, List<RecipeParameterDto>>(
                "/api/parameters/batch", dtos);
            Snackbar.Add(L.Format("inspection.presetAddedFmt", group.GroupName, dtos.Count, dtos.First().ParamCode, dtos.Last().ParamCode), Severity.Success);
            await LoadParams();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private HashSet<int> GetExistingCodes(int? excludeCode = null)
    {
        var codes = new HashSet<int>(_params.Select(p => p.ParamCode));
        if (excludeCode.HasValue)
            codes.Remove(excludeCode.Value);
        return codes;
    }

    private async Task OpenCreateDialog()
    {
        var nextCode = await GetNextCode();
        var parameters = new DialogParameters<InspectionItemFormDialog>
        {
            { x => x.Model, new RecipeParameterDto
                {
                    RecipeId = _selectedRecipeId!.Value,
                    ParamCode = nextCode
                }
            },
            { x => x.IsEdit, false },
            { x => x.ExistingCodes, GetExistingCodes() }
        };
        var dialog = await Dialog.ShowAsync<InspectionItemFormDialog>(L["inspection.addParamTitle"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (RecipeParameterDto)result.Data!;
                await Api.PostAsync<RecipeParameterDto, RecipeParameterDto>("/api/parameters", dto);
                Snackbar.Add(L.Format("inspection.paramAddedFmt", dto.ParamCode), Severity.Success);
                await LoadParams();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(RecipeParameterDto param)
    {
        var parameters = new DialogParameters<InspectionItemFormDialog>
        {
            { x => x.Model, new RecipeParameterDto
                {
                    Id = param.Id,
                    RecipeId = param.RecipeId,
                    ParamCode = param.ParamCode,
                    ParamValue = param.ParamValue,
                    Description = param.Description,
                    Category = param.Category,
                    Unit = param.Unit,
                    // LSL/USL 누락 시 편집 저장이 규격 한계를 null 로 덮어써
                    // 조용히 소실되던 버그 (2026-08-20 실증 보고) — 반드시 복사.
                    LowerLimit = param.LowerLimit,
                    UpperLimit = param.UpperLimit,
                    IsActive = param.IsActive
                }
            },
            { x => x.IsEdit, true },
            { x => x.ExistingCodes, GetExistingCodes(param.ParamCode) }
        };
        var dialog = await Dialog.ShowAsync<InspectionItemFormDialog>(L.Format("inspection.editParamTitleFmt", param.ParamCode), parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (RecipeParameterDto)result.Data!;
                await Api.PutAsync<RecipeParameterDto, RecipeParameterDto>(
                    $"/api/parameters/{param.Id}", dto);
                Snackbar.Add(L.Format("inspection.paramUpdatedFmt", dto.ParamCode), Severity.Success);
                await LoadParams();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task DeleteParam(RecipeParameterDto param)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, $"{param.ParamCode} — {param.Description}" },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["inspection.confirmDeleteParamTitle"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await Api.DeleteAsync($"/api/parameters/{param.Id}");
            Snackbar.Add(L.Format("inspection.paramDeletedFmt", param.ParamCode), Severity.Warning);
            await LoadParams();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private async Task OpenCreateRecipeDialog()
    {
        if (!_selectedClientId.HasValue) return;

        // 대상 라인을 다이얼로그에 명시 — VMS 는 자기 ClientIndex 의 레시피만 내려받는다
        var targetClient = _clients.FirstOrDefault(c => c.Id == _selectedClientId.Value);
        var parameters = new DialogParameters<RecipeFormDialog>
        {
            { x => x.TargetClientLabel,
              targetClient is null ? null : $"#{targetClient.ClientIndex:D2} — {targetClient.Name}" }
        };
        var dialog = await Dialog.ShowAsync<RecipeFormDialog>(L["inspection.newRecipeTitle"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (RecipeDto)result.Data!;
                // 서버 검증(RecipeDtoValidator)이 body 의 ClientId > 0 을 요구 —
                // 다이얼로그는 이름/설명만 채우므로 선택된 라인 ID 를 여기서 주입.
                dto.ClientId = _selectedClientId.Value;
                var created = await Api.PostAsync<RecipeDto, RecipeDto>(
                    $"/api/clients/{_selectedClientId.Value}/recipes", dto);
                Snackbar.Add(L.Format("inspection.recipeCreatedFmt", created?.Name ?? ""), Severity.Success);

                _recipes = await Api.GetAsync<List<RecipeDto>>(
                    $"/api/clients/{_selectedClientId.Value}/recipes") ?? new();
                if (created != null)
                    await OnRecipeChanged(created.Id);
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("inspection.recipeCreateFailedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task DeleteSelectedRecipe()
    {
        if (!_selectedRecipeId.HasValue) return;

        var recipe = _recipes.FirstOrDefault(r => r.Id == _selectedRecipeId);
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, recipe?.Name ?? "" },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["inspection.confirmDeleteRecipeTitle"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        try
        {
            var response = await Api.DeleteWithResponseAsync($"/api/clients/recipes/{_selectedRecipeId.Value}");
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                // 작업지시가 참조 중인 레시피 — 서버가 보낸 상세 사유를 그대로 안내
                var reason = await response.Content.ReadFromJsonAsync<string>();
                Snackbar.Add(string.IsNullOrEmpty(reason)
                    ? L["inspection.recipeDeleteBlocked"] : reason, Severity.Warning);
                return;
            }
            response.EnsureSuccessStatusCode();
            Snackbar.Add(L.Format("inspection.recipeDeletedFmt", recipe?.Name ?? ""), Severity.Warning);
            _selectedRecipeId = null;
            _params = new();
            _recipes = await Api.GetAsync<List<RecipeDto>>(
                $"/api/clients/{_selectedClientId!.Value}/recipes") ?? new();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private class NextCodeResponse { public int NextCode { get; set; } }
}
