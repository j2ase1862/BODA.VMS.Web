@page "/spc"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

<PageTitle>@L["page.spc"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.spc"]</MudText>

@* 용어 도움말 — 항상 표시 (사용자 요청 2026-08-13) *@
<div class="vms-banner info mb-4">
    <span class="vms-banner-label">HELP</span>
    <span class="vms-banner-text">@L["spc.helpBanner"]</span>
</div>

@* 6a — 필터 바: 4b 공통 패턴. 파라미터는 규격 설정 여부를 그린 라벨로 표기 *@
<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.line"]</label>
            <MudSelect T="int?" Value="_clientId" ValueChanged="OnClientChanged" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["common.all"]</MudSelectItem>
                @foreach (var c in _clients)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">
                        #@c.ClientIndex.ToString("D2") — @c.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.recipe"]</label>
            <MudSelect T="int?" Value="_recipeId" ValueChanged="OnRecipeChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Disabled="@(!_clientId.HasValue)">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["spc.selectRecipe"]</MudSelectItem>
                @foreach (var r in _recipes)
                {
                    <MudSelectItem T="int?" Value="@((int?)r.Id)">@r.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-field wide">
            <label class="vms-filter-label">@L["spc.parameter"]</label>
            <MudSelect T="int?" @bind-Value="_paramCode"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Disabled="@(!_recipeId.HasValue)">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["spc.selectParam"]</MudSelectItem>
                @foreach (var p in _params)
                {
                    <MudSelectItem T="int?" Value="@((int?)p.ParamCode)">
                        @p.ParamCode — @p.Description
                        @if (p.UpperLimit.HasValue || p.LowerLimit.HasValue)
                        {
                            <span class="vms-spec-set">@L["spc.specSet"]</span>
                        }
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-field" style="min-width:90px;">
            <label class="vms-filter-label">@L["spc.subgroupSize"]</label>
            <MudNumericField T="int" @bind-Value="_subgroupSize"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="2" Max="10" />
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ShowChart"
                   OnClick="Compute" Disabled="@(!_paramCode.HasValue)" Class="vms-btn">
            @L["action.calculate"]
        </MudButton>
    </div>
</MudPaper>

@if (_result is not null && _result.SubgroupCount > 0)
{
    @* 요약 5카드 — Cp/Cpk 카드만 등급별 좌측 색띠 + 판정 보조문 등급 색 *@
    <div class="vms-sum-grid cols-5 mb-4">
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["spc.measurements"]</span>
            <span class="vms-sum-value mono">@_result.TotalMeasurements.ToString("N0")</span>
            <span class="vms-sum-sub">@L.Format("spc.subgroupsLineFmt", _result.SubgroupCount, _result.SubgroupSize)</span>
        </MudPaper>
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["spc.grandMean"]</span>
            <span class="vms-sum-value mono">@_result.GrandMean.ToString("F4")<span class="vms-sum-unit">@_result.Unit</span></span>
            @if (_result.TargetValue.HasValue)
            {
                <span class="vms-sum-sub">@L.Format("spc.targetValueFmt", _result.TargetValue.Value.ToString("F4"))</span>
            }
        </MudPaper>
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["spc.estimatedSigma"]</span>
            <span class="vms-sum-value mono">@_result.EstimatedSigma.ToString("F4")</span>
            <span class="vms-sum-sub">@L["spc.sigmaSource"]</span>
        </MudPaper>
        <MudPaper Class="vms-panel vms-sum-card" Style="@($"border-left: 3px solid {CpkColor(_result.Cpk)} !important;")">
            <span class="vms-sum-label">@L["spc.cpCpk"]</span>
            <span class="vms-sum-value mono">@(_result.Cp?.ToString("F2") ?? "—") / @(_result.Cpk?.ToString("F2") ?? "—")</span>
            <span class="vms-sum-sub" style="color:@CpkColor(_result.Cpk);">@CpkVerdict(_result.Cpk)</span>
        </MudPaper>
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["spc.ppPpk"]</span>
            <span class="vms-sum-value mono">@(_result.Pp?.ToString("F2") ?? "—") / @(_result.Ppk?.ToString("F2") ?? "—")</span>
            <span class="vms-sum-sub">@L["spc.ppSource"]</span>
        </MudPaper>
    </div>

    @if (!_result.LowerLimit.HasValue || !_result.UpperLimit.HasValue)
    {
        <div class="vms-banner warn mb-4">
            <span class="vms-banner-label">USL/LSL</span>
            <span class="vms-banner-text">@L["spc.uslLslMissing"] @L["spc.uslLslAction"]</span>
        </div>
    }

    @* X̄ 관리도 — UCL/LCL 적 점선, CL 블루 실선, 이탈점만 확대 + 모노 라벨 (README 6a) *@
    <MudPaper Class="vms-panel pa-5 mb-4">
        <div class="vms-spc-head">
            <MudText Class="vms-panel-header">@L["spc.xbarChart"]</MudText>
            <span class="vms-spc-limits">
                UCL @_result.UclXbar.ToString("F4") · CL @_result.GrandMean.ToString("F4") · LCL @_result.LclXbar.ToString("F4")
            </span>
        </div>
        @ControlChart(_xbarGeom)
    </MudPaper>

    @* R 관리도 — 동일 규칙 *@
    <MudPaper Class="vms-panel pa-5 mb-4">
        <div class="vms-spc-head">
            <MudText Class="vms-panel-header">@L["spc.rChart"]</MudText>
            <span class="vms-spc-limits">
                UCL @_result.UclR.ToString("F4") · R̄ @_result.MeanOfRanges.ToString("F4") · LCL @_result.LclR.ToString("F4")
            </span>
        </div>
        @ControlChart(_rGeom)
    </MudPaper>

    <div class="vms-table">
        <MudTable Items="_result.Subgroups" Dense="true" Hover="true" Elevation="0">
            <ToolBarContent>
                <MudText Class="vms-panel-header">@L["spc.subgroupDetails"]</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="width:60px;">@L["spc.colIndex"]</MudTh>
                <MudTh>@L["spc.colStartTime"]</MudTh>
                <MudTh Style="text-align:right;">X̄</MudTh>
                <MudTh Style="text-align:right;">R</MudTh>
                <MudTh>@L["spc.colOutOfControl"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="vms-mono-dim">@context.Index</span></MudTd>
                <MudTd><span class="vms-mono-dim">@context.StartTime.ToLocalTime().ToString("MM-dd HH:mm:ss")</span></MudTd>
                <MudTd Style="text-align:right;"><span class="vms-mono">@context.Mean.ToString("F4")</span></MudTd>
                <MudTd Style="text-align:right;"><span class="vms-mono">@context.Range.ToString("F4")</span></MudTd>
                <MudTd>
                    @foreach (var ooc in OutOfControlReasons(context))
                    {
                        <span class="vms-ooc-badge">@ooc</span>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
}
else if (_result is not null)
{
    <div class="vms-banner info">
        <span class="vms-banner-label">DATA</span>
        <span class="vms-banner-text">@L.Format("spc.insufficientFmt", _subgroupSize, _result.TotalMeasurements)</span>
    </div>
}
else
{
    <div class="vms-panel pa-8 d-flex flex-column align-center">
        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large"
                 Style="color: var(--vms-text-secondary); opacity: 0.3;" Class="mb-2" />
        <MudText Style="color: var(--vms-text-secondary);">
            @L["spc.promptCompute"]
        </MudText>
        <MudText Typo="Typo.caption" Style="color: var(--vms-text-secondary); opacity: 0.7;">
            @L["spc.uslLslHint"]
        </MudText>
    </div>
}

@code {
    private int? _clientId;
    private int? _recipeId;
    private int? _paramCode;
    private int _subgroupSize = 5;

    private List<ClientDto> _clients = new();
    private List<RecipeDto> _recipes = new();
    private List<RecipeParameterDto> _params = new();
    private SpcResultDto? _result;

    private ChartGeom? _xbarGeom;
    private ChartGeom? _rGeom;

    // 관리도 지오메트리 — 좌표는 0~100 백분율 (SVG viewBox + HTML 오버레이 공용)
    private sealed record ChartPoint(double X, double Y, bool Ooc, int Index);
    private sealed record ChartGeom(string Polyline, List<ChartPoint> Points,
                                    double UclY, double LclY, double CenterY, string[] XLabels);

    private RenderFragment ControlChart(ChartGeom? g) => __builder =>
    {
        if (g is null) return;
        <div class="vms-spc-chart">
            @for (var i = 1; i <= 3; i++)
            {
                <div class="vms-spc-grid" style="top:@(i * 25)%"></div>
            }
            <div class="vms-spc-limit" style="top:@Pct(g.UclY)"></div>
            <div class="vms-spc-limit" style="top:@Pct(g.LclY)"></div>
            <div class="vms-spc-center" style="top:@Pct(g.CenterY)"></div>
            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <polyline class="vms-spc-line" points="@g.Polyline" />
            </svg>
            @foreach (var p in g.Points)
            {
                @if (p.Ooc)
                {
                    <span class="vms-spc-ooc-label" style="left:@Pct(p.X); top:@Pct(p.Y)">
                        @L.Format("spc.oocFmt", p.Index)
                    </span>
                }
                <span class="vms-spc-pt @(p.Ooc ? "ooc" : "")" style="left:@Pct(p.X); top:@Pct(p.Y)"></span>
            }
        </div>
        <div class="vms-spc-x">
            @foreach (var lb in g.XLabels)
            {
                <span>@lb</span>
            }
        </div>
    };

    private static string Pct(double v) =>
        v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
    }

    private async Task OnClientChanged(int? id)
    {
        _clientId = id;
        _recipeId = null; _paramCode = null;
        _params = new();
        if (id.HasValue)
            _recipes = await Api.GetAsync<List<RecipeDto>>($"/api/clients/{id}/recipes") ?? new();
        else
            _recipes = new();
    }

    private async Task OnRecipeChanged(int? id)
    {
        _recipeId = id;
        _paramCode = null;
        if (id.HasValue)
            _params = await Api.GetAsync<List<RecipeParameterDto>>($"/api/parameters/recipe/{id}") ?? new();
        else
            _params = new();
    }

    private async Task Compute()
    {
        if (!_recipeId.HasValue || !_paramCode.HasValue) return;

        var req = new SpcRequestDto
        {
            RecipeId = _recipeId.Value,
            ParamCode = _paramCode.Value,
            ClientId = _clientId,
            SubgroupSize = _subgroupSize,
            MaxSubgroups = 25
        };
        try
        {
            _result = await Api.PostAsync<SpcRequestDto, SpcResultDto>("/api/spc/compute", req);
            BuildCharts();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private void BuildCharts()
    {
        _xbarGeom = null; _rGeom = null;
        if (_result is null || _result.Subgroups.Count == 0) return;

        var subs = _result.Subgroups;
        _xbarGeom = BuildGeom(subs.Select(s => s.Mean).ToList(),
                              _result.UclXbar, _result.LclXbar, _result.GrandMean,
                              subs.Select(s => s.Index).ToList());
        _rGeom = BuildGeom(subs.Select(s => s.Range).ToList(),
                           _result.UclR, _result.LclR, _result.MeanOfRanges,
                           subs.Select(s => s.Index).ToList());
    }

    private static ChartGeom BuildGeom(List<double> values, double ucl, double lcl, double center, List<int> indices)
    {
        var min = Math.Min(values.Min(), Math.Min(lcl, center));
        var max = Math.Max(values.Max(), Math.Max(ucl, center));
        var span = max - min;
        var pad = span > 0 ? span * 0.15 : Math.Abs(max) * 0.1 + 1;
        min -= pad; max += pad;
        var range = max - min;

        double YOf(double v) => (max - v) / range * 100.0;
        double XOf(int i) => values.Count == 1 ? 50.0 : i / (double)(values.Count - 1) * 100.0;

        var pts = new List<ChartPoint>();
        var poly = new System.Text.StringBuilder();
        for (var i = 0; i < values.Count; i++)
        {
            var x = XOf(i);
            var y = YOf(values[i]);
            var ooc = values[i] > ucl || values[i] < lcl;
            pts.Add(new ChartPoint(x, y, ooc, indices[i]));
            poly.Append(Pt(x)).Append(',').Append(Pt(y)).Append(' ');
        }

        return new ChartGeom(poly.ToString().TrimEnd(), pts,
                             YOf(ucl), YOf(lcl), YOf(center),
                             indices.Select(i => i.ToString()).ToArray());
    }

    private static string Pt(double v) =>
        v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // X̄·R 동시 이탈 부분군은 배지를 모두 표시
    private IEnumerable<string> OutOfControlReasons(SpcSubgroup s)
    {
        if (_result is null) yield break;
        if (s.Mean > _result.UclXbar) yield return "X̄ > UCL";
        if (s.Mean < _result.LclXbar) yield return "X̄ < LCL";
        if (s.Range > _result.UclR) yield return "R > UCL";
        if (s.Range < _result.LclR && _result.LclR > 0) yield return "R < LCL";
    }

    // 등급 색은 README 6a 고정 팔레트 — ≥1.67 그린 / ≥1.33 블루 / ≥1.00 앰버 / 미달 레드
    private static string CpkColor(double? cpk)
    {
        if (cpk is null) return "var(--vms-hairline)";
        if (cpk >= 1.67) return "#3DD068";
        if (cpk >= 1.33) return "#5B9BE0";
        if (cpk >= 1.00) return "#E0A32E";
        return "#F0564C";
    }

    private string CpkVerdict(double? cpk)
    {
        if (cpk is null) return L["spc.verdictUslLslMissing"];
        if (cpk >= 1.67) return L["spc.verdictExcellent"];
        if (cpk >= 1.33) return L["spc.verdictGood"];
        if (cpk >= 1.00) return L["spc.verdictNeedsAction"];
        return L["spc.verdictNotMet"];
    }
}
