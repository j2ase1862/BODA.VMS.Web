@page "/operators"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject ILocalizer L
@inject SignalRService Signal
@implements IAsyncDisposable

<PageTitle>@L["page.operators"] - BODA VMS</PageTitle>

@* 8a CRUD 패턴 적용 — 헤더 부제, INFO 배너, vms-tabs *@
<div class="vms-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="vms-page-title">@L["page.operators"]</MudText>
        <div class="vms-page-sub">@L.Format("operator.totalCountFmt", _items.Count)</div>
    </div>
</div>

<div class="vms-banner info mb-4">
    <span class="vms-banner-label">INFO</span>
    <span class="vms-banner-text">@L["operator.alertInfo"]</span>
</div>

<MudTabs Elevation="0" Rounded="false" PanelClass="pa-0 mt-3" Class="vms-tabs"
         SliderColor="Color.Primary" Style="background: transparent;">
    <MudTabPanel Text="@(L["operator.tabMaster"])">
        <MudPaper Class="vms-filter-bar pa-0 mb-4 mt-3">
            <div class="vms-filter-flex">
                <div class="vms-filter-field xwide">
                    <label class="vms-filter-label">@L["common.search"]</label>
                    <MudTextField @bind-Value="_search" Placeholder="@(L["defect.searchPlaceholder"])"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                </div>
                <label class="vms-toggle" style="margin-bottom:10px;">
                    <input type="checkbox" checked="@_showInactive" @onchange="OnShowInactiveChanged" />
                    <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                    <span class="vms-toggle-label">@L["common.showInactive"]</span>
                </label>
                <div class="vms-filter-spacer"></div>
                <AuthorizeView Roles="Admin,User">
                    <Authorized>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                   Variant="Variant.Filled" OnClick="OpenCreateDialog" Class="vms-btn">
                            @L["operator.btnCreate"]
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </div>
        </MudPaper>

        <div class="vms-table">
            <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0"
                      Filter="new Func<OperatorDto, bool>(FilterFunc)">
                <HeaderContent>
                    <MudTh>@L["operator.colEmployeeNumber"]</MudTh>
                    <MudTh>@L["common.name"]</MudTh>
                    <MudTh>@L["operator.colDepartment"]</MudTh>
                    <MudTh>@L["common.status"]</MudTh>
                    <MudTh Style="text-align:right;">@L["common.actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="vms-cell-id">@context.EmployeeNumber</span></MudTd>
                    <MudTd><span style="font-weight:500;">@context.Name</span></MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.Department))
                        {
                            <span class="vms-type-chip">@context.Department</span>
                        }
                        else { <span class="vms-cell-empty">—</span> }
                    </MudTd>
                    <MudTd>
                        <span class="vms-wo-chip @(context.IsActive ? "st-done" : "st-flat")">
                            @(context.IsActive ? L["status.active"] : L["status.inactive"])
                        </span>
                    </MudTd>
                    <MudTd Style="text-align:right; white-space:nowrap;">
                        <AuthorizeView Roles="Admin,User">
                            <Authorized Context="auth1">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                           OnClick="@(() => OpenEditDialog(context))">@L["workorder.actEdit"]</MudButton>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="auth2">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                                           OnClick="@(() => DeleteItem(context))">@L["workorder.actDelete"]</MudButton>
                            </Authorized>
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="vms-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" />
                        <span class="vms-empty-text">@L["operator.noOperators"]</span>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudTabPanel>

    <MudTabPanel Text="@(L["operator.tabSessions"])">
        <MudPaper Class="vms-filter-bar pa-0 mb-4 mt-3">
            <div class="vms-filter-flex">
                <div class="vms-filter-field">
                    <label class="vms-filter-label">@L["common.line"]</label>
                    <MudSelect T="int?" @bind-Value="_filterClientId" Clearable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="int?" Value="@((int?)null)">@L["common.all"]</MudSelectItem>
                        @foreach (var c in _clients)
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.Id)">
                                #@c.ClientIndex.ToString("D2") @c.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="vms-filter-field">
                    <label class="vms-filter-label">@L["common.startDate"]</label>
                    <MudDatePicker @bind-Date="_filterStart"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <div class="vms-filter-field">
                    <label class="vms-filter-label">@L["common.endDate"]</label>
                    <MudDatePicker @bind-Date="_filterEnd"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadSessions" Class="vms-btn">@L["action.search"]</MudButton>
            </div>
        </MudPaper>

        <div class="vms-table">
            <MudTable Items="_sessions" Dense="true" Hover="true" Loading="_loadingSessions" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["common.operator"]</MudTh>
                    <MudTh>@L["operator.colEmployeeNumber"]</MudTh>
                    <MudTh>@L["common.line"]</MudTh>
                    <MudTh>@L["operator.colStartedAt"]</MudTh>
                    <MudTh>@L["operator.colEndedAt"]</MudTh>
                    <MudTh Style="text-align:right;">@L["operator.colDuration"]</MudTh>
                    <MudTh>@L["operator.colEndReason"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span style="font-weight:500;">@context.OperatorName</span></MudTd>
                    <MudTd><span class="vms-mono-dim">@context.EmployeeNumber</span></MudTd>
                    <MudTd>
                        <span class="vms-mono-dim">#@context.ClientIndex.ToString("D2")</span>
                        <span style="font-size:12.5px;"> @context.ClientName</span>
                    </MudTd>
                    <MudTd><span class="vms-mono-dim">@context.StartedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</span></MudTd>
                    <MudTd>
                        @if (context.EndedAt.HasValue)
                        {
                            <span class="vms-mono-dim">@context.EndedAt.Value.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                        }
                        else
                        {
                            <span class="vms-wo-chip st-run">@L["operator.currentlyWorking"]</span>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right;">
                        <span class="vms-mono">@FormatMinutes(context.DurationMinutes)</span>
                    </MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.EndReason))
                        {
                            <span class="vms-type-chip">@ReasonLabel(context.EndReason, L)</span>
                        }
                        else { <span class="vms-cell-empty">—</span> }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="vms-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.History" />
                        <span class="vms-empty-text">@L["operator.noSessions"]</span>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudTabPanel>

    <MudTabPanel Text="@(L["operator.tabKiosk"])">
        <MudPaper Class="vms-panel pa-5 mt-3">
            <div class="vms-set-title">@L["operator.kioskTitle"]</div>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mb-4">
                @L["operator.kioskInstruction"]
            </MudText>
            @if (_clients.Count == 0)
            {
                <div class="vms-empty"><span class="vms-empty-text">@L["operator.kioskNoLines"]</span></div>
            }
            else
            {
                <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap:10px;">
                    @foreach (var c in _clients)
                    {
                        <div class="vms-panel pa-3" style="background: #0C121D;">
                            <div class="vms-oee-idx" style="font-size:18px;">#@c.ClientIndex.ToString("D2")</div>
                            <div style="font-weight:600; margin: 2px 0;">@c.Name</div>
                            <div class="vms-mono-dim" style="font-size:11px; word-break: break-all;">
                                @KioskUrl(c.ClientIndex)
                            </div>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action mt-1"
                                       OnClick="@(() => Nav.NavigateTo(KioskUrl(c.ClientIndex), forceLoad: false))">
                                @L["operator.btnOpen"]
                            </MudButton>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private List<OperatorDto> _items = new();
    private List<OperatorSessionDto> _sessions = new();
    private List<ClientDto> _clients = new();
    private bool _loading;
    private bool _loadingSessions;
    private bool _showInactive;
    private string _search = "";
    private int? _filterClientId;
    private DateTime? _filterStart = DateTime.Today.AddDays(-7);
    private DateTime? _filterEnd = DateTime.Today; // 종료일 하루 끝 포함은 QueryDate.EndUtc 가 처리

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
        await Load();
        await LoadSessions();

        // SignalR — VMS 작업자 로그인/로그아웃 시 Sessions 탭 자동 갱신
        Signal.OnOperatorSessionStarted += OnSessionChanged;
        Signal.OnOperatorSessionEnded += OnSessionChanged;
        await Signal.StartAsync();
    }

    private async void OnSessionChanged(OperatorSessionDto _)
    {
        await InvokeAsync(async () =>
        {
            await LoadSessions();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        Signal.OnOperatorSessionStarted -= OnSessionChanged;
        Signal.OnOperatorSessionEnded -= OnSessionChanged;
        await Task.CompletedTask;
    }

    private async Task Load()
    {
        _loading = true;
        _items = await Api.GetAsync<List<OperatorDto>>(
            $"/api/operators?includeInactive={_showInactive}") ?? new();
        _loading = false;
    }

    private async Task LoadSessions()
    {
        _loadingSessions = true;
        var q = new List<string> { "limit=200" };
        if (_filterClientId.HasValue) q.Add($"clientId={_filterClientId}");
        if (_filterStart.HasValue) q.Add($"startDate={QueryDate.StartUtc(_filterStart)!.Value:yyyy-MM-ddTHH:mm:ss}");
        if (_filterEnd.HasValue) q.Add($"endDate={QueryDate.EndUtc(_filterEnd)!.Value:yyyy-MM-ddTHH:mm:ss}");
        _sessions = await Api.GetAsync<List<OperatorSessionDto>>(
            $"/api/operators/sessions?" + string.Join("&", q)) ?? new();
        _loadingSessions = false;
    }

    private bool FilterFunc(OperatorDto o)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return o.EmployeeNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || o.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (o.Department?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<OperatorFormDialog>
        {
            { x => x.Model, new OperatorUpsertDto { IsActive = true } },
            { x => x.IsEdit, false }
        };
        var dialog = await Dialog.ShowAsync<OperatorFormDialog>(L["operator.createTitle"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (OperatorUpsertDto)result.Data!;
                await Api.PostAsync<OperatorUpsertDto, OperatorDto>("/api/operators", dto);
                Snackbar.Add(L.Format("operator.createdFmt", dto.Name), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(OperatorDto src)
    {
        var copy = new OperatorUpsertDto
        {
            EmployeeNumber = src.EmployeeNumber,
            Name = src.Name,
            Department = src.Department,
            IsActive = src.IsActive,
            Pin = null
        };
        var parameters = new DialogParameters<OperatorFormDialog>
        {
            { x => x.Model, copy },
            { x => x.IsEdit, true }
        };
        var dialog = await Dialog.ShowAsync<OperatorFormDialog>(L.Format("operator.editTitleFmt", src.Name), parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (OperatorUpsertDto)result.Data!;
                await Api.PutAsync<OperatorUpsertDto, OperatorDto>($"/api/operators/{src.Id}", dto);
                Snackbar.Add(L.Format("operator.updatedFmt", dto.Name), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OnShowInactiveChanged(ChangeEventArgs e)
    {
        _showInactive = e.Value is true;
        await Load();
    }

    private async Task DeleteItem(OperatorDto o)
    {
        // 8b 파괴적 확인 — 대상 식별자 모노 명시
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, $"{o.EmployeeNumber} — {o.Name}" },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["confirm.delete"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;
        try
        {
            await Api.DeleteAsync($"/api/operators/{o.Id}");
            Snackbar.Add(L.Format("operator.deletedFmt", o.Name), Severity.Warning);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private string KioskUrl(int idx) =>
        $"{Nav.BaseUri.TrimEnd('/')}/kiosk/{idx}";

    private static string FormatMinutes(double mins)
    {
        if (mins < 60) return $"{mins:F0}분";
        var h = (int)(mins / 60); var m = (int)(mins % 60);
        return $"{h}시간 {m}분";
    }

    private static string ReasonLabel(string r, ILocalizer L) => r switch
    {
        "Logout" => L["operator.reasonLogout"],
        "ShiftChange" => L["operator.reasonShiftChange"],
        "Auto" => L["operator.reasonAuto"],
        _ => r
    };

}
