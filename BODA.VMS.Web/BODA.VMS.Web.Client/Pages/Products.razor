@page "/products"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject ILocalizer L

<PageTitle>@L["page.products"] - BODA VMS</PageTitle>

@* 8a CRUD 패턴 적용 — 헤더 부제 요약, 필터 바(검색·토글) 우측 끝 등록 버튼 *@
<div class="vms-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="vms-page-title">@L["page.products"]</MudText>
        <div class="vms-page-sub">@L.Format("product.totalCountFmt", _items.Count)</div>
    </div>
</div>

<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field wide">
            <label class="vms-filter-label">@L["common.search"]</label>
            <MudTextField @bind-Value="_search" Placeholder="@(L["product.searchPlaceholder"])"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </div>
        <label class="vms-toggle" style="margin-bottom:10px;">
            <input type="checkbox" checked="@_showInactive" @onchange="OnShowInactiveChanged" />
            <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
            <span class="vms-toggle-label">@L["common.showInactive"]</span>
        </label>
        <div class="vms-filter-spacer"></div>
        <AuthorizeView Roles="Admin,User">
            <Authorized>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                           Variant="Variant.Filled" OnClick="OpenCreateDialog" Class="vms-btn">
                    @L["product.btnCreate"]
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </div>
</MudPaper>

<div class="vms-table">
    <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0"
              Filter="new Func<ProductDto, bool>(FilterFunc)">
        <HeaderContent>
            <MudTh>@L["product.colCode"]</MudTh>
            <MudTh>@L["product.colName"]</MudTh>
            <MudTh>@L["product.colSpec"]</MudTh>
            <MudTh>@L["product.colDefaultRecipe"]</MudTh>
            <MudTh>@L["common.status"]</MudTh>
            <MudTh Style="text-align: right;">@L["common.actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span class="vms-cell-id">@context.Code</span></MudTd>
            <MudTd><span style="font-weight:500;">@context.Name</span></MudTd>
            <MudTd>
                @if (string.IsNullOrEmpty(context.Specification))
                {
                    <span class="vms-cell-empty">—</span>
                }
                else
                {
                    <span style="color: var(--mud-palette-text-secondary); font-size:12.5px;">@context.Specification</span>
                }
            </MudTd>
            <MudTd>
                @if (context.DefaultRecipeId.HasValue)
                {
                    <span class="vms-type-chip">@context.DefaultRecipeName</span>
                }
                else { <span class="vms-cell-empty">—</span> }
            </MudTd>
            <MudTd>
                <span class="vms-wo-chip @(context.IsActive ? "st-done" : "st-flat")">
                    @(context.IsActive ? L["status.active"] : L["status.inactive"])
                </span>
            </MudTd>
            <MudTd Style="text-align: right; white-space: nowrap;">
                <AuthorizeView Roles="Admin,User">
                    <Authorized Context="auth1">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                   OnClick="@(() => OpenEditDialog(context))">@L["workorder.actEdit"]</MudButton>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Admin">
                    <Authorized Context="auth2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                                   OnClick="@(() => DeleteItem(context))">@L["workorder.actDelete"]</MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="vms-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" />
                <span class="vms-empty-text">@L["product.noProducts"]</span>
            </div>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    private List<ProductDto> _items = new();
    private bool _loading;
    private bool _showInactive;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _items = await Api.GetAsync<List<ProductDto>>(
            $"/api/products?includeInactive={_showInactive}") ?? new();
        _loading = false;
    }

    private async Task OnShowInactiveChanged(ChangeEventArgs e)
    {
        _showInactive = e.Value is true;
        await Load();
    }

    private bool FilterFunc(ProductDto p)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return p.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ProductFormDialog>
        {
            { x => x.Model, new ProductDto() },
            { x => x.IsEdit, false }
        };
        var dialog = await Dialog.ShowAsync<ProductFormDialog>(L["product.createTitle"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (ProductDto)result.Data!;
                await Api.PostAsync<ProductDto, ProductDto>("/api/products", dto);
                Snackbar.Add(L.Format("product.createdFmt", dto.Code), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(ProductDto src)
    {
        var copy = new ProductDto
        {
            Id = src.Id,
            Code = src.Code,
            Name = src.Name,
            Specification = src.Specification,
            DefaultRecipeId = src.DefaultRecipeId,
            DefaultRecipeName = src.DefaultRecipeName,
            IsActive = src.IsActive
        };
        var parameters = new DialogParameters<ProductFormDialog>
        {
            { x => x.Model, copy },
            { x => x.IsEdit, true }
        };
        var dialog = await Dialog.ShowAsync<ProductFormDialog>(L.Format("product.editTitleFmt", src.Code), parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (ProductDto)result.Data!;
                await Api.PutAsync<ProductDto, ProductDto>($"/api/products/{src.Id}", dto);
                Snackbar.Add(L.Format("product.updatedFmt", dto.Code), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task DeleteItem(ProductDto p)
    {
        // 8b 파괴적 확인 — 대상 식별자 모노 명시
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, $"{p.Code} — {p.Name}" },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["confirm.delete"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await Api.DeleteAsync($"/api/products/{p.Id}");
            Snackbar.Add(L.Format("product.deletedFmt", p.Code), Severity.Warning);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }
}
