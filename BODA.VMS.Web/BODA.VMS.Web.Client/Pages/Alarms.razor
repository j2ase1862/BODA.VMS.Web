@page "/alarms"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject SignalRService SignalR
@inject ILocalizer L
@implements IDisposable

<PageTitle>@L["page.alarms"] - BODA VMS</PageTitle>

@* 5a — 헤더: 부제는 최근 24시간 건수(사용자에게 의미 있는 정보만),
   우측 '모두 확인'은 NotificationBell 제거에 따라 이 페이지로 이동 (README 5a 구현 노트) *@
<div class="vms-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="vms-page-title">@L["page.alarms"]</MudText>
        @if (_last24h >= 0)
        {
            <div class="vms-page-sub">@L.Format("alarms.last24hFmt", _last24h)</div>
        }
    </div>
    <AuthorizeView Roles="Admin,User" Context="auth">
        <Authorized>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.DoneAll"
                       OnClick="AcknowledgeAll" Disabled="@(_processing || (_summary?.NewCount ?? 0) == 0)"
                       Class="vms-btn">
                @L["alarms.ackAll"]
            </MudButton>
        </Authorized>
    </AuthorizeView>
</div>

@* 요약 3카드 — 좌측 3px 색띠 3색 구분(신규 오렌지 / 확인 블루 / Critical 적), Critical 만 배경·테두리 강조 *@
<div class="vms-sum-grid cols-3 mb-4">
    <MudPaper Class="vms-panel vms-sum-card band-new">
        <span class="vms-sum-label">@L["alarms.summaryNew"]</span>
        <span class="vms-sum-value">@(_summary?.NewCount ?? 0)</span>
    </MudPaper>
    <MudPaper Class="vms-panel vms-sum-card band-ack">
        <span class="vms-sum-label">@L["alarms.summaryAck"]</span>
        <span class="vms-sum-value">@(_summary?.AckCount ?? 0)</span>
    </MudPaper>
    <MudPaper Class="vms-panel vms-sum-card band-crit">
        <span class="vms-sum-label">@L["alarms.summaryCritical"]</span>
        <span class="vms-sum-value">@(_summary?.CriticalCount ?? 0)</span>
    </MudPaper>
</div>

@* 필터 바 — 4b 공통 패턴: 외부 모노 라벨 + 주 액션(검색) 오렌지 *@
<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["alarms.filterState"]</label>
            <MudSelect T="string?" @bind-Value="_state" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string?" Value="@((string?)null)">@L["common.all"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("New")">@L["status.new"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Ack")">@L["status.ack"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Resolved")">@L["status.resolved"]</MudSelectItem>
            </MudSelect>
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["alarms.filterSeverity"]</label>
            <MudSelect T="string?" @bind-Value="_severity" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string?" Value="@((string?)null)">@L["common.all"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Critical")">@L["status.critical"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Major")">@L["status.major"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Minor")">@L["status.minor"]</MudSelectItem>
            </MudSelect>
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["alarms.filterType"]</label>
            <MudSelect T="string?" @bind-Value="_type" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string?" Value="@((string?)null)">@L["common.all"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("NG")">@L["alarms.typeNG"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Offline")">@L["alarms.typeOffline"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("HighNgRate")">@L["alarms.typeHighNgRate"]</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Other")">@L["alarms.typeOther"]</MudSelectItem>
            </MudSelect>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="Load" Class="vms-btn">@L["action.search"]</MudButton>
    </div>
</MudPaper>

<div class="vms-table">
    <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0">
        <HeaderContent>
            <MudTh>@L["alarms.colOccurred"]</MudTh>
            <MudTh>@L["common.type"]</MudTh>
            <MudTh>@L["common.severity"]</MudTh>
            <MudTh>@L["common.line"]</MudTh>
            <MudTh>@L["alarms.colTitle"]</MudTh>
            <MudTh>@L["common.status"]</MudTh>
            <MudTh>@L["alarms.colAck"]</MudTh>
            <MudTh>@L["alarms.colResolved"]</MudTh>
            <MudTh Style="text-align:right;">@L["common.actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <span class="vms-mono-dim">
                    @context.OccurredAt.ToLocalTime().ToString("MM-dd HH:mm:ss")
                </span>
            </MudTd>
            <MudTd>
                <span class="vms-type-chip">@TypeLabel(context.AlarmType)</span>
            </MudTd>
            <MudTd>
                <span class="vms-sev-badge @SevClass(context.Severity)">@context.Severity.ToUpperInvariant()</span>
            </MudTd>
            <MudTd>
                @if (context.ClientName is not null)
                {
                    <span class="vms-mono-dim">#@context.ClientIndex?.ToString("D2")</span>
                    <span style="font-size:12.5px;"> @context.ClientName</span>
                }
                else { <span class="vms-cell-empty">—</span> }
            </MudTd>
            <MudTd>
                <div>
                    <div class="vms-cell-title">@context.Title</div>
                    @if (!string.IsNullOrEmpty(context.Message))
                    {
                        <div class="vms-cell-msg">@context.Message</div>
                    }
                </div>
            </MudTd>
            <MudTd>
                <span class="vms-state-chip @StateClass(context.State)">@StateLabel(context.State)</span>
            </MudTd>
            <MudTd>
                @if (context.AcknowledgedAt.HasValue)
                {
                    <div class="vms-cell-who">@context.AcknowledgedByName</div>
                    <div class="vms-cell-when">
                        @context.AcknowledgedAt.Value.ToLocalTime().ToString("MM-dd HH:mm")
                    </div>
                }
                else { <span class="vms-cell-empty">—</span> }
            </MudTd>
            <MudTd>
                @if (context.ResolvedAt.HasValue)
                {
                    <div class="vms-cell-who">@context.ResolvedByName</div>
                    <div class="vms-cell-when">
                        @context.ResolvedAt.Value.ToLocalTime().ToString("MM-dd HH:mm")
                    </div>
                    @if (!string.IsNullOrEmpty(context.Resolution))
                    {
                        <div class="vms-cell-resolution">@context.Resolution</div>
                    }
                }
                else { <span class="vms-cell-empty">—</span> }
            </MudTd>
            <MudTd Style="text-align:right; white-space:nowrap;">
                @{ var row = context; }
                <AuthorizeView Roles="Admin,User" Context="auth">
                    <Authorized>
                        @* 해결된 행은 액션 없음 — 텍스트 링크 #5B9BE0 (README 표 패턴) *@
                        @if (row.ResolvedAt is null)
                        {
                            @if (row.AcknowledgedAt is null)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                           OnClick="@(() => Acknowledge(row))">@L["alarms.actAck"]</MudButton>
                            }
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                       OnClick="@(() => Resolve(row))">@L["alarms.actResolve"]</MudButton>
                        }
                    </Authorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="pa-8 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Size="Size.Large"
                         Style="color: var(--vms-text-secondary); opacity: 0.3;" Class="mb-2" />
                <MudText Style="color: var(--vms-text-secondary);">@L["alarms.noData"]</MudText>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</div>

@code {
    private List<AlarmEventDto> _items = new();
    private AlarmSummaryDto? _summary;
    private bool _loading;
    private bool _processing;
    private int _last24h = -1;
    private string? _state = "New";
    private string? _severity;
    private string? _type;

    protected override async Task OnInitializedAsync()
    {
        SignalR.OnAlarmCreated += HandleAlarmChanged;
        SignalR.OnAlarmUpdated += HandleAlarmChanged;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var q = new List<string> { "pageSize=100" };
        if (!string.IsNullOrEmpty(_state)) q.Add($"state={_state}");
        if (!string.IsNullOrEmpty(_severity)) q.Add($"severity={_severity}");
        if (!string.IsNullOrEmpty(_type)) q.Add($"alarmType={_type}");
        var url = "/api/alarms?" + string.Join("&", q);

        try
        {
            var page = await Api.GetAsync<PagedResult<AlarmEventDto>>(url);
            _items = page?.Items ?? new();
            _summary = await Api.GetAsync<AlarmSummaryDto>("/api/alarms/summary");

            // 헤더 부제용 최근 24시간 발생 건수 — 기존 목록 API 의 startDate 필터 + TotalCount 재사용
            var since = DateTime.UtcNow.AddHours(-24).ToString("yyyy-MM-ddTHH:mm:ss");
            var recent = await Api.GetAsync<PagedResult<AlarmEventDto>>(
                $"/api/alarms?startDate={since}&pageSize=1");
            _last24h = recent?.TotalCount ?? -1;
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
        _loading = false;
    }

    private async void HandleAlarmChanged(AlarmEventDto a) => await InvokeAsync(Load);

    private async Task AcknowledgeAll()
    {
        _processing = true;
        try
        {
            var result = await Api.PostAsync<object, AckAllResponse>("/api/alarms/acknowledge-all", new { });
            Snackbar.Add(L.Format("alarms.ackAllDoneFmt", result?.Acknowledged ?? 0), Severity.Success);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
        finally { _processing = false; }
    }

    private async Task Acknowledge(AlarmEventDto a)
    {
        try
        {
            await Api.PostAsync<AlarmActionRequest, AlarmEventDto>(
                $"/api/alarms/{a.Id}/action",
                new AlarmActionRequest { Action = "Acknowledge" });
            Snackbar.Add(L.Format("alarms.ackedFmt", a.Title), Severity.Info);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private async Task Resolve(AlarmEventDto a)
    {
        var parameters = new DialogParameters<AlarmResolveDialog>
        {
            { x => x.Alarm, a }
        };
        var dialog = await Dialog.ShowAsync<AlarmResolveDialog>(L.Format("alarms.resolveTitleFmt", a.Title), parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await Api.PostAsync<AlarmActionRequest, AlarmEventDto>(
                $"/api/alarms/{a.Id}/action",
                new AlarmActionRequest { Action = "Resolve", Resolution = (string)result.Data! });
            Snackbar.Add(L.Format("alarms.resolvedFmt", a.Title), Severity.Success);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private string TypeLabel(string t) => t switch
    {
        "NG" => L["alarms.typeNG"],
        "Offline" => L["alarms.typeOffline"],
        "HighNgRate" => L["alarms.typeHighNgRate"],
        _ => L["alarms.typeOther"]
    };

    private string StateLabel(string s) => s switch
    {
        "New" => L["status.new"],
        "Ack" => L["status.ack"],
        "Resolved" => L["status.resolved"],
        _ => s
    };

    private static string SevClass(string sev) => sev switch
    {
        "Critical" => "crit",
        "Major" => "warn",
        _ => "info"
    };

    private static string StateClass(string s) => s switch
    {
        "New" => "st-new",
        "Ack" => "st-ack",
        "Resolved" => "st-res",
        _ => "st-ack"
    };

    public void Dispose()
    {
        SignalR.OnAlarmCreated -= HandleAlarmChanged;
        SignalR.OnAlarmUpdated -= HandleAlarmChanged;
    }

    private class AckAllResponse
    {
        public int Acknowledged { get; set; }
    }
}
