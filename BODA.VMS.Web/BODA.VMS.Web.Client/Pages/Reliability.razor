@page "/reliability"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

<PageTitle>@L["page.reliability"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.reliability"]</MudText>

@* 9f — FORMULA 배너 (6b 동일 패턴) *@
<div class="vms-banner info mb-4">
    <span class="vms-banner-label">FORMULA</span>
    <span class="vms-banner-text">@L["reliability.formulaAlert"] @L["reliability.formulaDetail"]</span>
</div>

<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.startDate"]</label>
            <MudDatePicker @bind-Date="_startDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.endDate"]</label>
            <MudDatePicker @bind-Date="_endDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.line"]</label>
            <MudSelect T="int?" @bind-Value="_clientId" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["common.all"]</MudSelectItem>
                @foreach (var c in _clients)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">
                        #@c.ClientIndex.ToString("D2") @c.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Calculate"
                   OnClick="Calculate" Class="vms-btn">@L["action.calculate"]</MudButton>
    </div>
</MudPaper>

@if (_stats.Count > 0)
{
    @* 라인 카드 — 상단 3px 색띠 = 가용률 등급 (기존 임계값 유지, 저채도) *@
    <div class="vms-rel-grid">
        @foreach (var s in _stats)
        {
            var g = Grade(s.Availability);
            <div class="vms-panel vms-rel-card @g">
                <div class="vms-rel-head">
                    <div class="vms-rel-title">
                        <span class="vms-oee-idx">#@s.ClientIndex.ToString("D2")</span> @s.ClientName
                    </div>
                    <div class="vms-rel-fail">
                        <span class="vms-oee-label">@L["reliability.failureCount"]</span>
                        <span class="vms-rel-fail-count @(s.FailureCount > 0 ? "bad" : "ok")">@s.FailureCount</span>
                    </div>
                </div>

                <div class="vms-rel-duo">
                    <div class="vms-rel-duo-cell">
                        <span class="vms-rel-duo-label">@L["reliability.mtbf"]</span>
                        <span class="vms-rel-duo-value">@(s.MtbfHours.HasValue ? $"{s.MtbfHours.Value:F1}h" : "—")</span>
                        <span class="vms-rel-duo-desc">@L["reliability.mtbfDescription"]</span>
                    </div>
                    <div class="vms-rel-duo-cell">
                        <span class="vms-rel-duo-label">@L["reliability.mttr"]</span>
                        <span class="vms-rel-duo-value">@(s.MttrHours.HasValue ? $"{s.MttrHours.Value:F1}h" : "—")</span>
                        <span class="vms-rel-duo-desc">@L["reliability.mttrDescription"]</span>
                    </div>
                </div>

                <div class="vms-rel-avail">
                    <span class="vms-rel-avail-label">@L["reliability.availability"]</span>
                    <span class="vms-rel-avail-value">
                        @(s.Availability.HasValue ? (s.Availability.Value * 100).ToString("F2") + "%" : "—")
                    </span>
                </div>

                <div class="vms-rel-foot">
                    <span class="run">@L.Format("reliability.runningHoursFmt", s.TotalRunningHours.ToString("F1"))</span>
                    <span class="down">@L.Format("reliability.downHoursFmt", s.TotalDownHours.ToString("F1"))</span>
                </div>
            </div>
        }
    </div>
}
else if (_loaded)
{
    <MudPaper Class="vms-panel">
        <div class="vms-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Insights" />
            <span class="vms-empty-text">@L["reliability.noData"]</span>
        </div>
    </MudPaper>
}
else
{
    <MudPaper Class="vms-panel">
        <div class="vms-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Insights" />
            <span class="vms-empty-text">@L["reliability.promptCalc"]</span>
        </div>
    </MudPaper>
}

@code {
    private DateTime? _startDate = DateTime.Today.AddDays(-7);
    private DateTime? _endDate = DateTime.Today.AddDays(1);
    private int? _clientId;
    private List<ClientDto> _clients = new();
    private List<ReliabilityStatsDto> _stats = new();
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
        await Calculate();
    }

    private async Task Calculate()
    {
        if (!_startDate.HasValue || !_endDate.HasValue) return;
        var req = new ReliabilityRequestDto
        {
            StartDate = _startDate.Value.ToUniversalTime(),
            EndDate = _endDate.Value.ToUniversalTime(),
            ClientId = _clientId
        };
        try
        {
            _stats = await Api.PostAsync<ReliabilityRequestDto, List<ReliabilityStatsDto>>(
                "/api/reliability/calculate", req) ?? new();
            _loaded = true;
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    // 가용률 등급 — 기존 임계값 유지 (≥95 / ≥85 / ≥70 / 미달)
    private static string Grade(double? avail)
    {
        if (!avail.HasValue) return "g-none";
        if (avail >= 0.95) return "g95";
        if (avail >= 0.85) return "g85";
        if (avail >= 0.70) return "g70";
        return "g-bad";
    }
}
