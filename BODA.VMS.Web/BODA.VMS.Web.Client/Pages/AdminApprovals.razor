@page "/admin/approvals"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject ILocalizer L

<PageTitle>@L["page.approvals"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.approvals"]</MudText>

@* 12b — 탭 2개 (오렌지 언더라인은 .vms-tabs), 대기 배지는 앰버(경고이지 오류가 아님) *@
<MudTabs Elevation="0" Rounded="false" PanelClass="pa-4"
         SliderColor="Color.Primary"
         Class="vms-tabs vms-appr-tabs"
         Style="background: transparent;">
    <MudTabPanel Text="@(L["approval.tabPending"])" BadgeData="@_pendingUsers.Count" BadgeColor="Color.Warning">
        @if (_pendingUsers.Count == 0)
        {
            <MudPaper Class="vms-panel">
                <div class="vms-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                    <span class="vms-empty-text">@L["approval.noPending"]</span>
                </div>
            </MudPaper>
        }
        else
        {
            <div class="vms-table">
                <MudTable Items="_pendingUsers" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>@L["approval.colUsername"]</MudTh>
                        <MudTh>@L["approval.colDisplayName"]</MudTh>
                        <MudTh>@L["approval.colCreatedAt"]</MudTh>
                        <MudTh Style="text-align: right;">@L["common.actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><span class="vms-cell-id">@context.Username</span></MudTd>
                        <MudTd>@context.DisplayName</MudTd>
                        <MudTd>
                            <span class="vms-mono-dim">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        </MudTd>
                        <MudTd Style="text-align: right; white-space: nowrap;">
                            @* 역할 지정 승인 — 전부 아웃라인, 권한 강도 순 좌→우, 테두리 색으로만 강도 구분.
                               채운 버튼 금지(최고 권한 강조 = 오조작 위험). 개별 버튼 간격 6px *@
                            <button type="button" class="vms-role-btn guest"
                                    @onclick="@(() => ApproveUser(context, "Guest"))">@L["approval.btnApproveGuest"]</button>
                            <button type="button" class="vms-role-btn user"
                                    @onclick="@(() => ApproveUser(context, "User"))">@L["approval.btnApproveUser"]</button>
                            <button type="button" class="vms-role-btn admin"
                                    @onclick="@(() => ApproveUser(context, "Admin"))">@L["approval.btnApproveAdmin"]</button>
                            <span class="vms-vdiv"></span>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                                       OnClick="@(() => RejectUser(context))">@L["approval.btnReject"]</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                <div class="vms-slots-info">@L["approval.rejectWarning"]</div>
            </div>
        }
    </MudTabPanel>

    <MudTabPanel Text="@(L["approval.tabAll"])">
        <div class="vms-table">
            <MudTable Items="_allUsers" Dense="true" Hover="true" Elevation="0"
                      Filter="new Func<UserDto, bool>(FilterFunc)">
                <ToolBarContent>
                    <MudSpacer />
                    @* 검색 — 사용자명·표시 이름 부분 일치 (FilterFunc 유지, README 12b 필수) *@
                    <MudTextField @bind-Value="_searchString" Placeholder="@(L["approval.searchPlaceholder"])"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  IconSize="Size.Small" Class="mt-0" Immediate="true"
                                  Style="max-width: 300px;" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>@L["approval.colUsername"]</MudTh>
                    <MudTh>@L["approval.colDisplayName"]</MudTh>
                    <MudTh>@L["approval.colRole"]</MudTh>
                    <MudTh>@L["approval.colState"]</MudTh>
                    <MudTh Style="text-align: right;">@L["common.actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="vms-cell-id w500">@context.Username</span></MudTd>
                    <MudTd>@context.DisplayName</MudTd>
                    <MudTd>
                        @if (context.IsApproved && context.Username != "admin")
                        {
                            @* 역할 칩이 곧 변경 컨트롤 — ▼ 로 누를 수 있음을 표시, 현재 역할은 메뉴에서 비활성 *@
                            <MudMenu ActivationEvent="MouseEvent.LeftClick" Dense="true"
                                     AnchorOrigin="Origin.BottomLeft">
                                <ActivatorContent>
                                    <span class="vms-role-chip @RoleChipClass(context)">@RoleChipLabel(context) ▼</span>
                                </ActivatorContent>
                                <ChildContent>
                                    @foreach (var role in new[] { "Admin", "User", "Guest" })
                                    {
                                        <MudMenuItem Disabled="@(role == context.Role)"
                                                     OnClick="@(() => ChangeRole(context, role))">@role</MudMenuItem>
                                    }
                                </ChildContent>
                            </MudMenu>
                        }
                        else
                        {
                            @* 승인 대기·admin 계정은 정적 칩 (▼ 없음) *@
                            <span class="vms-role-chip @RoleChipClass(context)">@RoleChipLabel(context)</span>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.IsApproved)
                        {
                            <span class="d-flex align-center">
                                <span class="vms-appr-led on"></span>
                                <span class="vms-appr-state on">@L["approval.stateActive"]</span>
                            </span>
                        }
                        else
                        {
                            <span class="d-flex align-center">
                                <span class="vms-appr-led off"></span>
                                <span class="vms-appr-state off">@L["approval.statePending"]</span>
                            </span>
                        }
                    </MudTd>
                    <MudTd Style="text-align: right; white-space: nowrap;">
                        @if (context.Username != "admin")
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                       OnClick="@(() => ResetPassword(context))">@L["approval.actResetPw"]</MudButton>
                            @* 사용자 삭제 (2026-08-11) — 자기 자신·마지막 Admin 은 서버가 409 로 차단 *@
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                                       OnClick="@(() => DeleteUser(context))">@L["approval.actDelete"]</MudButton>
                        }
                        else
                        {
                            @* admin 은 왜 버튼이 없는지를 설명 *@
                            <span class="vms-admin-locked">@L["approval.adminLocked"]</span>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <div class="vms-slots-info">@L["approval.footerHint"]</div>
        </div>
    </MudTabPanel>
</MudTabs>

@code {
    private List<UserDto> _pendingUsers = new();
    private List<UserDto> _allUsers = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _pendingUsers = await Api.GetAsync<List<UserDto>>("/api/admin/pending-users") ?? new();
        _allUsers = await Api.GetAsync<List<UserDto>>("/api/admin/users") ?? new();
    }

    private static string RoleChipClass(UserDto user)
    {
        if (!user.IsApproved) return "pending";
        return user.Role switch
        {
            "Admin" => "admin",
            "User" => "user",
            _ => "guest"
        };
    }

    private static string RoleChipLabel(UserDto user) =>
        (!user.IsApproved ? "PENDING" : user.Role.ToUpperInvariant());

    private async Task ApproveUser(UserDto user, string role)
    {
        await Api.PostAsync("/api/admin/approve", new ApprovalDto { UserId = user.Id, Role = role });
        Snackbar.Add(L.Format("approval.snackbarApprovedFmt", user.Username, role), Severity.Success);
        await LoadData();
    }

    private async Task RejectUser(UserDto user)
    {
        // 거부 = 계정 삭제 — 8b 파괴적 확인, 대상 사용자명 모노 명시
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, user.Username },
            { x => x.Message, L["approval.rejectWarning"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["approval.btnReject"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["approval.confirmRejectTitle"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        await Api.PostAsync<object>($"/api/admin/reject/{user.Id}", new { });
        Snackbar.Add(L.Format("approval.snackbarRejectedFmt", user.Username), Severity.Warning);
        await LoadData();
    }

    private async Task ChangeRole(UserDto user, string role)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, user.Username },
            { x => x.Message, L.Format("approval.confirmChangeRoleFmt", user.Username, user.Role, role) },
            { x => x.ConfirmText, L["action.confirm"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["approval.changeRoleTitle"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        var response = await Api.PutWithResponseAsync(
            $"/api/admin/users/{user.Id}/role", new { Role = role });
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(L.Format("approval.snackbarRoleChangedFmt", user.Username, role), Severity.Success);
            await LoadData();
        }
        else
        {
            // 409(마지막 Admin 강등 등)의 서버 사유를 그대로 안내 — 자체 문구로 덮지 않는다
            string? reason = null;
            try
            {
                var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                if (body.TryGetProperty("message", out var m)) reason = m.GetString();
            }
            catch { }
            Snackbar.Add(reason ?? L["approval.snackbarRoleChangeFailed"], Severity.Warning);
        }
    }

    private async Task DeleteUser(UserDto user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, $"{user.Username} — {user.DisplayName}" },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["approval.deleteUserTitle"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        var response = await Api.DeleteWithResponseAsync($"/api/admin/users/{user.Id}");
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(L.Format("approval.snackbarUserDeletedFmt", user.Username), Severity.Warning);
            await LoadData();
        }
        else
        {
            // 409(자기 자신/마지막 Admin 등)의 서버 사유를 그대로 안내
            string? reason = null;
            try
            {
                var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                if (body.TryGetProperty("message", out var m)) reason = m.GetString();
            }
            catch { }
            Snackbar.Add(reason ?? L["approval.snackbarUserDeleteFailed"], Severity.Warning);
        }
    }

    private async Task ResetPassword(UserDto user)
    {
        var confirmParams = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, user.Username },
            { x => x.Message, L.Format("approval.resetPasswordConfirmFmt", user.Username) },
            { x => x.ConfirmText, L["approval.actResetPw"] }
        };
        var confirmDlg = await Dialog.ShowAsync<ConfirmDialog>(L["approval.resetPasswordTitle"], confirmParams);
        var confirmResult = await confirmDlg.Result;
        if (confirmResult is null || confirmResult.Canceled) return;

        // 임시 비밀번호 재설계 (2026-08-11) — 서버가 생성한 임시 비밀번호를 응답으로 1회만 수신
        var response = await Api.PostWithResponseAsync(
            $"/api/admin/users/{user.Id}/reset-password", new { });
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(L["approval.snackbarResetFailed"], Severity.Warning);
            return;
        }

        string? temp = null;
        try
        {
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            if (body.TryGetProperty("tempPassword", out var t)) temp = t.GetString();
        }
        catch { }

        if (string.IsNullOrEmpty(temp))
        {
            Snackbar.Add(L["approval.snackbarResetFailed"], Severity.Warning);
            return;
        }

        // 12b — 복사 가능한 모노 텍스트 다이얼로그로 1회 표시
        var showParams = new DialogParameters<TempPasswordDialog>
        {
            { x => x.Username, user.Username },
            { x => x.TempPassword, temp }
        };
        var showDlg = await Dialog.ShowAsync<TempPasswordDialog>(L["approval.resetPasswordTitle"], showParams);
        await showDlg.Result;
        Snackbar.Add(L["approval.snackbarResetDone"], Severity.Success);
    }

    private bool FilterFunc(UserDto user) =>
        string.IsNullOrWhiteSpace(_searchString) ||
        user.Username.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        user.DisplayName.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
}
