@page "/oee"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

<PageTitle>@L["page.oee"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.oee"]</MudText>

@* 6b — 필터 바: 4b 공통 패턴 *@
<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.startDate"]</label>
            <MudDatePicker @bind-Date="_startDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.endDate"]</label>
            <MudDatePicker @bind-Date="_endDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.line"]</label>
            <MudSelect T="int?" @bind-Value="_clientId" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["common.all"]</MudSelectItem>
                @foreach (var c in _clients)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">
                        #@c.ClientIndex.ToString("D2") — @c.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Calculate"
                   OnClick="Calculate" Class="vms-btn">@L["action.calculate"]</MudButton>
    </div>
</MudPaper>

@if (_result is not null && _result.Clients.Count > 0)
{
    @* 공식 안내 — FORMULA 정보 배너 (README 6b) *@
    <div class="vms-banner info mb-4">
        <span class="vms-banner-label">FORMULA</span>
        <span class="vms-banner-text">@L["oee.formulaAlert"]</span>
    </div>

    @* 라인별 카드 — 저채도 팔레트 필수(카드 다수 배치), 상단 3px 등급색 띠 *@
    <div class="vms-oee-grid">
        @foreach (var c in _result.Clients)
        {
            var g = OeeGrade(c.Oee);
            <div class="vms-panel vms-oee-card @g">
                <div class="vms-oee-head">
                    <div class="vms-oee-title">
                        <span class="vms-oee-idx">#@c.ClientIndex.ToString("D2")</span> @c.ClientName
                    </div>
                    <div class="vms-oee-big">
                        <span class="vms-oee-label">OEE</span>
                        <span class="vms-oee-value">@((c.Oee * 100).ToString("F1"))%</span>
                    </div>
                </div>

                <div class="vms-oee-apq">
                    <div class="vms-oee-apq-cell">
                        <span class="vms-oee-apq-label">@L["oee.availability"]</span>
                        <span class="vms-oee-apq-value">@((c.Availability * 100).ToString("F1"))%</span>
                    </div>
                    <div class="vms-oee-apq-cell">
                        <span class="vms-oee-apq-label">@L["oee.performance"]</span>
                        <span class="vms-oee-apq-value">@((c.Performance * 100).ToString("F1"))%</span>
                    </div>
                    <div class="vms-oee-apq-cell">
                        <span class="vms-oee-apq-label">@L["oee.quality"]</span>
                        <span class="vms-oee-apq-value">@((c.Quality * 100).ToString("F1"))%</span>
                    </div>
                </div>

                @{
                    var runPct = c.PeriodSeconds > 0 ? c.RunningSeconds / c.PeriodSeconds * 100 : 0;
                    var idlePct = c.PeriodSeconds > 0 ? c.IdleSeconds / c.PeriodSeconds * 100 : 0;
                    var downPct = c.PeriodSeconds > 0 ? c.DownSeconds / c.PeriodSeconds * 100 : 0;
                }
                <div>
                    <div class="vms-oee-bar">
                        @if (runPct > 0)
                        {
                            <div class="seg run" style="width:@(runPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"
                                 title="@($"{L["status.running"]} {runPct:F1}%")"></div>
                        }
                        @if (idlePct > 0)
                        {
                            <div class="seg idle" style="width:@(idlePct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"
                                 title="@($"{L["status.idle"]} {idlePct:F1}%")"></div>
                        }
                        @if (downPct > 0)
                        {
                            <div class="seg down" style="width:@(downPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"
                                 title="@($"{L["status.down"]} {downPct:F1}%")"></div>
                        }
                    </div>
                    <div class="vms-oee-legend">
                        <span class="run">● @L["status.running"] @FormatHours(c.RunningSeconds)</span>
                        <span class="idle">● @L["status.idle"] @FormatHours(c.IdleSeconds)</span>
                        <span class="down">● @L["status.down"] @FormatHours(c.DownSeconds)</span>
                    </div>
                </div>

                <div class="vms-oee-foot">
                    <span>@L["common.total"] <strong>@c.TotalInspections.ToString("N0")</strong></span>
                    <span class="pass">@L["status.pass"] <strong>@c.PassCount.ToString("N0")</strong></span>
                    <span class="ng">@L["status.ng"] <strong>@c.NgCount.ToString("N0")</strong></span>
                </div>
            </div>
        }
    </div>
}
else if (_result is not null)
{
    <div class="vms-panel pa-8 d-flex flex-column align-center">
        <MudText Style="color: var(--vms-text-secondary);">@L["oee.noActiveLines"]</MudText>
    </div>
}
else
{
    <div class="vms-panel pa-8 d-flex flex-column align-center">
        <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Large"
                 Style="color: var(--vms-text-secondary); opacity: 0.3;" Class="mb-2" />
        <MudText Style="color: var(--vms-text-secondary);">@L["oee.promptCalc"]</MudText>
    </div>
}

@code {
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today.AddDays(1);
    private int? _clientId;

    private List<ClientDto> _clients = new();
    private OeeResultDto? _result;

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
        await Calculate();
    }

    private async Task Calculate()
    {
        if (!_startDate.HasValue || !_endDate.HasValue) return;
        var req = new OeeRequestDto
        {
            StartDate = _startDate.Value.ToUniversalTime(),
            EndDate = _endDate.Value.ToUniversalTime(),
            ClientId = _clientId
        };
        try
        {
            _result = await Api.PostAsync<OeeRequestDto, OeeResultDto>("/api/oee/calculate", req);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private static string FormatHours(double seconds)
    {
        if (seconds < 60) return $"{seconds:F0}초";
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}시간 {ts.Minutes}분";
        return $"{ts.Minutes}분 {ts.Seconds}초";
    }

    // 등급 클래스 — 임계값은 기존 GetOeeColor 유지 (≥85 정상 / ≥60 정보 / ≥40 경고 / 미달)
    private static string OeeGrade(double oee)
    {
        if (oee >= 0.85) return "g-ok";
        if (oee >= 0.60) return "g-info";
        if (oee >= 0.40) return "g-warn";
        return "g-bad";
    }
}
