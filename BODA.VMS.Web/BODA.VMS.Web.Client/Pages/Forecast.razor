@page "/forecast"
@attribute [Authorize]
@inject ApiClient Api
@inject IJSRuntime JS
@inject ILocalizer L
@implements IAsyncDisposable

<PageTitle>@L["page.forecast"]</PageTitle>

@* 9e — 헤더: 갱신 시각+주기 모노 + 새로고침 아웃라인. 60초 타이머 유지 (README 9e) *@
<div class="vms-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="vms-page-title">@L["page.forecast"]</MudText>
        @if (_snapshot is not null)
        {
            <div class="vms-page-sub">
                @L["forecast.lastRefreshed"] @_snapshot.ServerUtc.ToLocalTime().ToString("HH:mm:ss") · 60s
            </div>
        }
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="RefreshAsync" Disabled="_loading" Class="vms-btn">
        @L["forecast.refresh"]
    </MudButton>
</div>

@* 용어 도움말 — 항상 표시 (사용자 요청 2026-08-13) *@
<div class="vms-banner info mb-4">
    <span class="vms-banner-label">HELP</span>
    <span class="vms-banner-text">@L["forecast.helpBanner"]</span>
</div>

@* 모델 상태 — 앰버 배너 (적색은 실제 오류에만) *@
@if (_status is not null && !_status.ModelLoaded)
{
    <div class="vms-banner check mb-4">
        <span class="vms-banner-label">MODEL</span>
        <span class="vms-banner-text">
            @L["forecast.noModelBanner"]
            @if (!string.IsNullOrEmpty(_status.LastError))
            {
                <span class="vms-mono-dim"> — @_status.LastError</span>
            }
        </span>
    </div>
}
else if (_status is not null && _status.RetrainRecommended)
{
    <div class="vms-banner check mb-4">
        <span class="vms-banner-label">RETRAIN</span>
        <span class="vms-banner-text">
            @L["forecast.retrainBanner"]
            <span class="vms-mono-dim">
                (@L["forecast.residual.mae"] @(_status.ResidualMae?.ToString("F4") ?? "—")
                · @L["forecast.residual.samples"] @_status.ResidualSampleCount)
            </span>
        </span>
    </div>
}

@if (_loading && _snapshot is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_snapshot is null || _snapshot.Items.Count == 0)
{
    <MudPaper Class="vms-panel">
        <div class="vms-empty">
            <MudIcon Icon="@Icons.Material.Outlined.TrendingUp" />
            <span class="vms-empty-text">@L["forecast.empty"]</span>
        </div>
    </MudPaper>
}
else
{
    @* 11a — 13대 이상: 정렬/초과만/전환/Excel 툴바 *@
    @if (FleetEligible)
    {
        <MudPaper Class="vms-filter-bar pa-0 mb-4">
            <div class="vms-filter-flex">
                @if (TableMode)
                {
                    <div class="vms-filter-field" style="min-width:130px;">
                        <label class="vms-filter-label">@L["fleet.sort"]</label>
                        <MudSelect T="bool" @bind-Value="_sortWorst"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="bool" Value="true">@L["fleet.sortWorst"]</MudSelectItem>
                            <MudSelectItem T="bool" Value="false">@L["fleet.sortName"]</MudSelectItem>
                        </MudSelect>
                    </div>
                    <label class="vms-toggle" style="margin-bottom:10px;">
                        <input type="checkbox" @bind="_belowOnly" />
                        <span class="vms-toggle-track"><span class="vms-toggle-knob"></span></span>
                        <span class="vms-toggle-label">@L["fleet.belowOnly"]</span>
                    </label>
                }
                <div class="vms-filter-spacer"></div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn"
                           OnClick="ToggleView">
                    @(TableMode ? L["fleet.viewCards"] : L["fleet.viewTable"])
                </MudButton>
                @if (TableMode)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="vms-btn"
                               StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv">
                        @L["fleet.excel"]
                    </MudButton>
                }
            </div>
        </MudPaper>
    }

    @if (TableMode)
    {
        @* 요약 밴드 — 수치는 전부 표 데이터에서 계산 *@
        <div class="vms-sum-grid mb-4">
            <MudPaper Class="vms-panel vms-sum-card">
                <span class="vms-sum-label">@L["fleet.avg"] · @L["fleet.colPredNg"]</span>
                <span class="vms-sum-value mono">@(AvgPred.HasValue ? AvgPred.Value.ToString("F1") + "%" : "—")</span>
            </MudPaper>
            <MudPaper Class="@AlertCardClass">
                <span class="vms-sum-label">@L.Format("fleet.belowTargetFmt", "5%")</span>
                <span class="vms-sum-value mono">@L.Format("fleet.unitsFmt", BelowCount)</span>
            </MudPaper>
            <MudPaper Class="vms-panel vms-sum-card">
                <span class="vms-sum-label">@L["fleet.worst"]</span>
                <span class="vms-sum-value mono">@(WorstItem is null ? "—" : $"#{WorstItem.ClientIndex:D2}")</span>
                <span class="vms-sum-sub">@(WorstItem is null ? "" : $"{(WorstItem.PredictedNgRate!.Value * 100):F1}%")</span>
            </MudPaper>
            <MudPaper Class="vms-panel vms-sum-card">
                <span class="vms-sum-label">@L["fleet.totalInsp"]</span>
                <span class="vms-sum-value mono">@_snapshot.Items.Sum(i => i.InspectionCountThisHour).ToString("N0")</span>
            </MudPaper>
        </div>

        <MudPaper Class="vms-panel pa-0 mb-4">
            <div class="vms-flt-scroll">
                <table class="vms-flt-table">
                    <thead>
                        <tr>
                            <th>@L["common.line"]</th>
                            <th>@L["common.recipe"]</th>
                            <th>@L["fleet.colPredNg"]</th>
                            <th class="num">@L["fleet.colActual"]</th>
                            <th class="num">@L["fleet.colDelta"]</th>
                            <th class="num">@L["forecast.inspectionsThisHour"]</th>
                            <th>@L["fleet.trend24h"]</th>
                            <th>@L["fleet.remark"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in VisibleRows)
                        {
                            var ok = item.Status == "ok" && item.PredictedNgRate.HasValue;
                            var pct = ok ? item.PredictedNgRate!.Value * 100.0 : 0;
                            var g = ok ? FltGrade(pct) : "";
                            var below = ok && pct >= Target;
                            _fleetActuals.TryGetValue(item.ClientIndex, out var act);
                            <tr class="@(below ? $"below {g}" : "")" style="cursor:pointer;"
                                @onclick="@(() => SelectClient(item.ClientIndex))">
                                <td class="vms-flt-num vms-flt-dim" style="text-align:left;">#@item.ClientIndex.ToString("D2")</td>
                                <td>@(string.IsNullOrEmpty(item.RecipeName) ? "—" : item.RecipeName)</td>
                                <td>
                                    @if (ok)
                                    {
                                        <div class="vms-flt-gauge @g">
                                            <div class="track"><div class="fill" style="width:@Pctw(Math.Min(pct, 20) / 20)"></div></div>
                                            <span class="val">@pct.ToString("F1")%</span>
                                        </div>
                                    }
                                    else { <span class="vms-flt-dim">—</span> }
                                </td>
                                <td class="vms-flt-num">@(act?.LastPct is double a ? a.ToString("F1") + "%" : "—")</td>
                                <td class="vms-flt-num">
                                    @if (ok && act?.LastPct is double av)
                                    {
                                        var delta = pct - av;
                                        <span style="color:@(delta > 0 ? "#C4756E" : "#7FA98C")">@(delta >= 0 ? "+" : "")@delta.ToString("F1")%p</span>
                                    }
                                    else { <span class="vms-flt-dim">—</span> }
                                </td>
                                <td class="vms-flt-num">@item.InspectionCountThisHour.ToString("N0")</td>
                                <td>
                                    @if (act?.Spark is string sp)
                                    {
                                        <svg class="vms-flt-spark @(ok ? g : "g-ok")" viewBox="0 0 86 22" preserveAspectRatio="none">
                                            <polyline points="@sp" />
                                        </svg>
                                    }
                                    else { <span class="vms-flt-dim">—</span> }
                                </td>
                                <td style="font-size:12px; color:#8C96A6; white-space:normal; min-width:180px;">
                                    @(ok ? "" : (item.Message ?? L["forecast.noData"]))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    }
    else
    {

    @* 예측 카드 — 좌측 4px 색띠 = 등급, ok 아니면 사유 문장만 (0% 오독 방지) *@
    <div class="vms-fc-grid mb-4">
        @foreach (var item in _snapshot.Items)
        {
            var ok = item.Status == "ok" && item.PredictedNgRate.HasValue;
            var pct = ok ? item.PredictedNgRate!.Value * 100.0 : 0;
            <div class="vms-panel vms-fc-card @(ok ? Grade(pct) : "") @(item.ClientIndex == _selectedClientIndex ? "sel" : "")"
                 @onclick="@(() => SelectClient(item.ClientIndex))">
                <div class="vms-fc-head">
                    <span class="vms-fc-line">#@item.ClientIndex.ToString("D2")
                        <span class="vms-fc-recipe">@(string.IsNullOrEmpty(item.RecipeName) ? "—" : item.RecipeName)</span>
                    </span>
                    <span class="vms-fc-status @StatusClass(item.Status)">@StatusText(item.Status)</span>
                </div>

                @if (ok)
                {
                    <div class="vms-fc-value">@pct.ToString("F1")%</div>
                    <div class="vms-fc-caption">@L["forecast.predictedWindow"]</div>
                    <div class="vms-fc-foot">
                        <span>@(item.WindowStart?.ToLocalTime().ToString("MM-dd HH:mm") ?? "—")</span>
                        <span>@L["forecast.inspectionsThisHour"] @item.InspectionCountThisHour</span>
                    </div>
                }
                else
                {
                    <div class="vms-fc-reason">@(item.Message ?? L["forecast.noData"])</div>
                }
            </div>
        }
    </div>

    }

    @* 실적 대조 — 실선 실측 + 마지막 점→예측 점선 연장 + 예측 점/라벨 *@
    <MudPaper Class="vms-panel pa-5 mb-4">
        <div class="vms-spc-head">
            <MudText Class="vms-panel-header">@L["forecast.historyTitle"]</MudText>
            @if (_selectedClientIndex.HasValue)
            {
                <span class="vms-spc-limits">
                    #@_selectedClientIndex.Value.ToString("D2")@(string.IsNullOrEmpty(_actuals?.RecipeName) ? "" : $" · {_actuals!.RecipeName}")
                </span>
            }
        </div>

        @if (!_selectedClientIndex.HasValue)
        {
            <div class="vms-empty"><span class="vms-empty-text">@L["forecast.selectClient"]</span></div>
        }
        else if (_actuals is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_actuals.Points.Count == 0)
        {
            <div class="vms-empty"><span class="vms-empty-text">@L["forecast.noHistory"]</span></div>
        }
        else
        {
            <div class="vms-spc-chart">
                @for (var i = 1; i <= 3; i++)
                {
                    <div class="vms-spc-grid" style="top:@(i * 25)%"></div>
                }
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    <polyline class="vms-fc-line-actual" points="@_actualPolyline" />
                    @if (_predPoint is not null)
                    {
                        <line class="vms-fc-line-pred"
                              x1="@Pt(_lastActualX)" y1="@Pt(_lastActualY)"
                              x2="@Pt(_predPoint.Value.X)" y2="@Pt(_predPoint.Value.Y)"
                              pathLength="30" />
                    }
                </svg>
                @if (_predPoint is not null)
                {
                    <span class="vms-fc-pred-label" style="left:@Pct(_predPoint.Value.X); top:@Pct(_predPoint.Value.Y)">
                        @_predPoint.Value.Label
                    </span>
                    <span class="vms-fc-pred-pt" style="left:@Pct(_predPoint.Value.X); top:@Pct(_predPoint.Value.Y)"></span>
                }
            </div>
            <div class="vms-spc-x">
                @foreach (var lb in _actualXLabels)
                {
                    <span>@lb</span>
                }
            </div>
        }
    </MudPaper>

    @* 잔차 관리도 — SPC 공통 스타일 재사용, 이탈점만 강조 *@
    @if (_selectedClientIndex.HasValue)
    {
        <MudPaper Class="vms-panel pa-5 mb-4">
            <div class="vms-spc-head">
                <MudText Class="vms-panel-header">@L["forecast.residual.title"]</MudText>
                @if (_residuals is not null && _residuals.Points.Count > 0)
                {
                    <span class="vms-spc-limits">
                        μ @_residuals.ResidualMean.ToString("F4") · σ @_residuals.ResidualStdDev.ToString("F4") · n @_residuals.Points.Count
                    </span>
                }
            </div>

            @if (_residuals is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_residuals.Points.Count == 0)
            {
                <div class="vms-empty"><span class="vms-empty-text">@L["forecast.residual.empty"]</span></div>
            }
            else
            {
                <div class="vms-spc-chart">
                    @for (var i = 1; i <= 3; i++)
                    {
                        <div class="vms-spc-grid" style="top:@(i * 25)%"></div>
                    }
                    <div class="vms-spc-limit" style="top:@Pct(_resGeom!.UclY)"></div>
                    <div class="vms-spc-limit" style="top:@Pct(_resGeom.LclY)"></div>
                    <div class="vms-spc-center" style="top:@Pct(_resGeom.CenterY)"></div>
                    <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                        <polyline class="vms-spc-line dim" points="@_resGeom.Polyline" />
                    </svg>
                    @foreach (var p in _resGeom.Points)
                    {
                        @if (p.Ooc)
                        {
                            <span class="vms-spc-ooc-label" style="left:@Pct(p.X); top:@Pct(p.Y)">@L["forecast.oocLabel"]</span>
                            <span class="vms-spc-pt ooc muted" style="left:@Pct(p.X); top:@Pct(p.Y)"></span>
                        }
                        else
                        {
                            <span class="vms-spc-pt" style="left:@Pct(p.X); top:@Pct(p.Y)"></span>
                        }
                    }
                </div>
                <div class="vms-spc-x">
                    @foreach (var lb in _resGeom.XLabels)
                    {
                        <span>@lb</span>
                    }
                </div>
            }
        </MudPaper>
    }
}

@code {
    private const int TableThreshold = 13;
    private const double Target = 5.0;   // 예측 NG율 % — 경고 임계값과 동일

    private PredictionSnapshotResponse? _snapshot;
    private RecentActualsResponse? _actuals;
    private ResidualsResponse? _residuals;
    private PredictionServiceStatus? _status;
    private int? _selectedClientIndex;
    private bool _loading;
    private Timer? _refreshTimer;

    // 11a 표 모드
    private bool? _viewTable;
    private bool _sortWorst = true;
    private bool _belowOnly;
    private sealed record FleetActual(double? LastPct, string? Spark);
    private Dictionary<int, FleetActual> _fleetActuals = new();

    private string AlertCardClass =>
        "vms-panel vms-sum-card vms-flt-alert " + (BelowCount > 0 ? WorstGrade : "");

    private bool FleetEligible => (_snapshot?.Items.Count ?? 0) >= TableThreshold;
    private bool TableMode => FleetEligible && (_viewTable ?? true);

    // 기본 정렬은 나쁜 순 (예측 NG율 내림차순, 예측 불가 행은 맨 뒤)
    private IEnumerable<PredictionCurrentResponse> VisibleRows
    {
        get
        {
            var items = _snapshot!.Items.AsEnumerable();
            if (_belowOnly)
                items = items.Where(i => i.Status == "ok" && i.PredictedNgRate.HasValue
                                         && i.PredictedNgRate.Value * 100 >= Target);
            return _sortWorst
                ? items.OrderByDescending(i => i.Status == "ok" ? i.PredictedNgRate ?? double.MinValue : double.MinValue)
                : items.OrderBy(i => i.ClientIndex);
        }
    }

    private double? AvgPred
    {
        get
        {
            var vals = _snapshot!.Items
                .Where(i => i.Status == "ok" && i.PredictedNgRate.HasValue)
                .Select(i => i.PredictedNgRate!.Value * 100).ToList();
            return vals.Count > 0 ? vals.Average() : null;
        }
    }

    private int BelowCount => _snapshot!.Items.Count(i =>
        i.Status == "ok" && i.PredictedNgRate.HasValue && i.PredictedNgRate.Value * 100 >= Target);

    private PredictionCurrentResponse? WorstItem => _snapshot!.Items
        .Where(i => i.Status == "ok" && i.PredictedNgRate.HasValue)
        .OrderByDescending(i => i.PredictedNgRate)
        .FirstOrDefault();

    private string WorstGrade => WorstItem is null ? "" : FltGrade(WorstItem.PredictedNgRate!.Value * 100);

    // 게이지/행/스파크 공용 등급 — 기존 임계값(≥10/≥5) 유지
    private static string FltGrade(double pct)
    {
        if (pct >= 10.0) return "g-bad";
        if (pct >= 5.0) return "g70";
        return "g-ok";
    }

    private static string Pctw(double ratio) =>
        (Math.Clamp(ratio, 0, 1) * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private async Task ToggleView()
    {
        _viewTable = !TableMode;
        if (TableMode && _fleetActuals.Count == 0) await LoadFleetActualsAsync();
    }

    // 24h 실적 — 표 모드에서만 라인별 병렬 조회 (실적·편차·스파크라인)
    private async Task LoadFleetActualsAsync()
    {
        if (_snapshot is null) return;
        var tasks = _snapshot.Items.Select(async item =>
        {
            try
            {
                var a = await Api.GetAsync<RecentActualsResponse>(
                    $"/api/predictions/actuals/{item.ClientIndex}?hours=24");
                if (a is null || a.Points.Count == 0)
                    return (item.ClientIndex, (FleetActual?)new FleetActual(null, null));
                var pcts = a.Points.Select(p => p.NgRate * 100.0).ToList();
                return (item.ClientIndex, (FleetActual?)new FleetActual(pcts[^1], SparkOf(pcts)));
            }
            catch
            {
                return (item.ClientIndex, (FleetActual?)null);
            }
        });
        var results = await Task.WhenAll(tasks);
        _fleetActuals = results
            .Where(r => r.Item2 is not null)
            .ToDictionary(r => r.ClientIndex, r => r.Item2!);
        await InvokeAsync(StateHasChanged);
    }

    // 86×22 스파크라인 (값 2개 미만이면 null → — 렌더)
    private static string? SparkOf(List<double> vals)
    {
        if (vals.Count < 2) return null;
        var max = Math.Max(vals.Max(), 0.001);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < vals.Count; i++)
        {
            var x = 2 + i / (double)(vals.Count - 1) * 82.0;
            var y = 20 - vals[i] / max * 18.0;
            sb.Append(x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
              .Append(',')
              .Append(y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
              .Append(' ');
        }
        return sb.ToString().TrimEnd();
    }

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"{L["common.line"]},{L["common.recipe"]},{L["fleet.colPredNg"]}(%),{L["fleet.colActual"]}(%),{L["fleet.colDelta"]}(%p),{L["forecast.inspectionsThisHour"]},{L["fleet.remark"]}");
        foreach (var i in VisibleRows)
        {
            var ok = i.Status == "ok" && i.PredictedNgRate.HasValue;
            _fleetActuals.TryGetValue(i.ClientIndex, out var act);
            var pred = ok ? (i.PredictedNgRate!.Value * 100).ToString("F1") : "";
            var actual = act?.LastPct?.ToString("F1") ?? "";
            var delta = ok && act?.LastPct is double av ? (i.PredictedNgRate!.Value * 100 - av).ToString("F1") : "";
            sb.AppendLine(string.Join(",",
                $"#{i.ClientIndex:D2}", CsvField(i.RecipeName), pred, actual, delta,
                i.InspectionCountThisHour, ok ? "" : CsvField(i.Message ?? "")));
        }
        var bytes = System.Text.Encoding.UTF8.GetBytes("﻿" + sb);
        await JS.InvokeVoidAsync("downloadFileFromBytes",
            $"forecast_{DateTime.Now:yyyyMMdd_HHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
    }

    private static string CsvField(string? v)
    {
        if (string.IsNullOrEmpty(v)) return "";
        var dq = '"'.ToString();
        return v.Contains(',') ? dq + v.Replace(dq, dq + dq) + dq : v;
    }

    // 실적 대조 차트 지오메트리 (0~100 백분율)
    private string _actualPolyline = "";
    private string[] _actualXLabels = Array.Empty<string>();
    private double _lastActualX;
    private double _lastActualY;
    private (double X, double Y, string Label)? _predPoint;

    // 잔차 관리도 지오메트리 — SPC 패턴과 동일 구조
    private sealed record ResPoint(double X, double Y, bool Ooc);
    private sealed record ResGeom(string Polyline, List<ResPoint> Points,
                                  double UclY, double LclY, double CenterY, string[] XLabels);
    private ResGeom? _resGeom;

    private static string Pct(double v) =>
        v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string Pt(double v) =>
        v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // PredictionService 캐시 TTL 과 동일 60초
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(60);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _refreshTimer = new Timer(async _ => await RefreshAsync(),
            null, RefreshInterval, RefreshInterval);
    }

    private async Task RefreshAsync()
    {
        if (_loading) return;
        _loading = true;
        try
        {
            await InvokeAsync(StateHasChanged);
            _snapshot = await Api.GetAsync<PredictionSnapshotResponse>("/api/predictions/snapshot");
            // Phase F: 잔차 통계 + 재학습 권고 시그널 포함 status 사용
            _status = await Api.GetAsync<PredictionServiceStatus>("/api/predictions/status/full");

            // 최초 진입 시 첫 카드 자동 선택
            if (_selectedClientIndex is null && _snapshot is { Items.Count: > 0 })
            {
                _selectedClientIndex = _snapshot.Items[0].ClientIndex;
            }

            if (_selectedClientIndex.HasValue)
            {
                await LoadActualsAsync(_selectedClientIndex.Value);
                await LoadResidualsAsync(_selectedClientIndex.Value);
            }

            // 11a 표 모드 — 실적/편차/24h 스파크라인용 라인별 실측
            if (TableMode) await LoadFleetActualsAsync();
        }
        catch
        {
            // 일시적 네트워크 실패 — 다음 tick 재시도
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectClient(int clientIndex)
    {
        _selectedClientIndex = clientIndex;
        _residuals = null;
        await LoadActualsAsync(clientIndex);
        await LoadResidualsAsync(clientIndex);
    }

    private async Task LoadActualsAsync(int clientIndex)
    {
        _actuals = await Api.GetAsync<RecentActualsResponse>(
            $"/api/predictions/actuals/{clientIndex}?hours=24");
        BuildChart();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadResidualsAsync(int clientIndex)
    {
        _residuals = await Api.GetAsync<ResidualsResponse>(
            $"/api/predictions/residuals/{clientIndex}?hours=168");
        BuildResidualChart();
        await InvokeAsync(StateHasChanged);
    }

    private void BuildChart()
    {
        _actualPolyline = "";
        _actualXLabels = Array.Empty<string>();
        _predPoint = null;
        if (_actuals is null || _actuals.Points.Count == 0) return;

        var pts = _actuals.Points;
        var n = pts.Count;
        var values = pts.Select(p => p.NgRate * 100.0).ToList();

        var current = _snapshot?.Items.FirstOrDefault(i => i.ClientIndex == _selectedClientIndex);
        double? pred = current?.Status == "ok" ? current.PredictedNgRate * 100.0 : null;

        var max = Math.Max(values.Max(), pred ?? 0);
        var min = Math.Min(values.Min(), pred ?? double.MaxValue);
        var span = max - min;
        var pad = span > 0 ? span * 0.15 : Math.Abs(max) * 0.15 + 0.5;
        min -= pad; max += pad;
        var range = max - min;

        double YOf(double v) => (max - v) / range * 100.0;
        // 실측은 0~90%, 예측 연장점은 97% — 마지막 점에서 이어지는 미래 시점
        double XOf(int i) => n == 1 ? 45.0 : i / (double)(n - 1) * 90.0;

        var poly = new System.Text.StringBuilder();
        for (var i = 0; i < n; i++)
        {
            poly.Append(Pt(XOf(i))).Append(',').Append(Pt(YOf(values[i]))).Append(' ');
        }
        _actualPolyline = poly.ToString().TrimEnd();
        _lastActualX = XOf(n - 1);
        _lastActualY = YOf(values[^1]);

        if (pred.HasValue)
        {
            _predPoint = (97.0, YOf(pred.Value), pred.Value.ToString("F1") + "%");
        }

        _actualXLabels = pts
            .Select((p, i) => i % 4 == 0 ? p.HourBucket.ToLocalTime().ToString("HH") : "")
            .ToArray();
    }

    private void BuildResidualChart()
    {
        _resGeom = null;
        if (_residuals is null || _residuals.Points.Count == 0) return;

        var pts = _residuals.Points;
        var n = pts.Count;
        var values = pts.Select(p => p.Residual).ToList();
        var ucl = _residuals.Ucl;
        var lcl = _residuals.Lcl;
        var center = _residuals.ResidualMean;

        var max = Math.Max(values.Max(), Math.Max(ucl, center));
        var min = Math.Min(values.Min(), Math.Min(lcl, center));
        var span = max - min;
        var pad = span > 0 ? span * 0.15 : Math.Abs(max) * 0.15 + 0.001;
        min -= pad; max += pad;
        var range = max - min;

        double YOf(double v) => (max - v) / range * 100.0;
        double XOf(int i) => n == 1 ? 50.0 : i / (double)(n - 1) * 100.0;

        var list = new List<ResPoint>();
        var poly = new System.Text.StringBuilder();
        for (var i = 0; i < n; i++)
        {
            var x = XOf(i);
            var y = YOf(values[i]);
            var ooc = values[i] > ucl || values[i] < lcl;
            list.Add(new ResPoint(x, y, ooc));
            poly.Append(Pt(x)).Append(',').Append(Pt(y)).Append(' ');
        }

        var labels = pts
            .Select((p, i) => i % Math.Max(1, n / 10) == 0
                ? p.WindowStart.ToLocalTime().ToString("MM-dd HH")
                : "")
            .ToArray();

        _resGeom = new ResGeom(poly.ToString().TrimEnd(), list,
                               YOf(ucl), YOf(lcl), YOf(center), labels);
    }

    // 등급 — 기존 임계값 유지 (≥10% 오류 / ≥5% 경고 / 정상)
    private static string Grade(double pct) => pct switch
    {
        >= 10.0 => "g-bad",
        >= 5.0 => "g-warn",
        _ => "g-ok",
    };

    private string StatusText(string status) => status switch
    {
        "ok" => L["forecast.status.ok"],
        "no_model" => L["forecast.status.noModel"],
        "no_data" => L["forecast.status.noData"],
        "error" => L["forecast.status.error"],
        _ => status,
    };

    private static string StatusClass(string status) => status switch
    {
        "ok" => "ok",
        "no_data" => "warn",
        "error" => "err",
        _ => "dim",
    };

    public async ValueTask DisposeAsync()
    {
        if (_refreshTimer is not null)
        {
            await _refreshTimer.DisposeAsync();
            _refreshTimer = null;
        }
    }
}
