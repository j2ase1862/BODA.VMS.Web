@page "/change-password"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILocalizer L
@inject Blazored.LocalStorage.ILocalStorageService Storage

<PageTitle>@L["page.changePassword"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.changePassword"]</MudText>

@* 카드 화면 중앙 배치 — 좌상단 붙음 피드백 (사용자 2026-08-13). 상단 내비+제목 높이를 뺀 영역에서 수직/수평 중앙 *@
<div class="d-flex justify-center align-center" style="min-height: calc(100vh - 220px);">
    <MudPaper Class="vms-panel pa-5" Style="width: 100%; max-width: 480px;">
            <div class="d-flex align-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Small"
                         Style="color: var(--vms-primary); margin-right: 8px;" />
                <MudText Class="vms-panel-header">@L["changePassword.sectionTitle"]</MudText>
            </div>

            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--vms-text-secondary);">
                @L["changePassword.intro"]
            </MudText>

            @* 8b 폼 패턴 — 외부 모노 라벨 + 필수 * , 새 비밀번호는 9b 강도 바 *@
            <div class="vms-form mb-6">
                <div>
                    <label class="vms-form-label" for="cpw-current">@L["changePassword.fieldCurrent"]<span class="req">*</span></label>
                    <MudTextField @bind-Value="_currentPassword" InputId="cpw-current"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  InputType="InputType.Password" />
                </div>
                <div>
                    <label class="vms-form-label" for="cpw-new">@L["changePassword.fieldNew"]<span class="req">*</span></label>
                    <MudTextField Value="_newPassword" ValueChanged="@((string v) => _newPassword = v)"
                                  T="string" Immediate="true" InputId="cpw-new"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  InputType="InputType.Password" />
                    <div class="vms-pw-meter">
                        @for (var i = 1; i <= 4; i++)
                        {
                            <span class="vms-pw-seg @(PwScore >= i ? "on" : "")"></span>
                        }
                    </div>
                    <div class="vms-pw-policy">@L["changePassword.policyHint"]</div>
                </div>
                <div>
                    <label class="vms-form-label" for="cpw-confirm">@L["changePassword.fieldConfirm"]<span class="req">*</span></label>
                    <MudTextField @bind-Value="_confirmPassword" InputId="cpw-confirm"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  InputType="InputType.Password" />
                </div>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="HandleSubmit" Disabled="_loading"
                       Size="Size.Large" Class="vms-btn">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["changePassword.btnSubmit"]
            </MudButton>
    </MudPaper>
</div>

@code {
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _loading;

    // 강도 바 — Register 와 동일 규칙 (문자 종류 수 0~4)
    private int PwScore
    {
        get
        {
            if (string.IsNullOrEmpty(_newPassword)) return 0;
            var classes = 0;
            if (_newPassword.Any(char.IsUpper)) classes++;
            if (_newPassword.Any(char.IsLower)) classes++;
            if (_newPassword.Any(char.IsDigit)) classes++;
            if (_newPassword.Any(c => !char.IsLetterOrDigit(c))) classes++;
            return classes;
        }
    }

    private async Task HandleSubmit()
    {
        // 클라이언트 선행 검증 — 서버(FluentValidation)와 동일 정책이지만 즉시 피드백용
        if (string.IsNullOrEmpty(_currentPassword) || string.IsNullOrEmpty(_newPassword))
        {
            Snackbar.Add(L["changePassword.errRequired"], Severity.Warning);
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add(L["changePassword.errMismatch"], Severity.Warning);
            return;
        }
        if (!IsComplexEnough(_newPassword))
        {
            Snackbar.Add(L["changePassword.errPolicy"], Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            var response = await Api.PostWithResponseAsync("/api/auth/change-password",
                new ChangePasswordRequest { CurrentPassword = _currentPassword, NewPassword = _newPassword });
            if (response.IsSuccessStatusCode)
            {
                // 임시 비밀번호 강제 변경 상태 해제 (MainLayout 리다이렉트 가드)
                await Storage.RemoveItemAsync("vms_must_change_pw");
                Snackbar.Add(L["changePassword.snackbarDone"], Severity.Success);
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            var reason = await ExtractErrorAsync(response);
            Snackbar.Add(reason ?? L["changePassword.snackbarFailed"], Severity.Error);
        }
        catch
        {
            Snackbar.Add(L["changePassword.snackbarFailed"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // 서버 PasswordPolicy.IsComplexEnough 와 동일 규칙 (KISA: 3종 8자+ / 2종 10자+)
    private static bool IsComplexEnough(string password)
    {
        var classes = 0;
        if (password.Any(char.IsUpper)) classes++;
        if (password.Any(char.IsLower)) classes++;
        if (password.Any(char.IsDigit)) classes++;
        if (password.Any(c => !char.IsLetterOrDigit(c))) classes++;

        return (classes >= 3 && password.Length >= 8)
            || (classes >= 2 && password.Length >= 10);
    }

    // Register.razor 와 동일 패턴 — ValidationProblemDetails / {message} 두 형태 모두 지원
    private static async Task<string?> ExtractErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var json = await response.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("errors", out var errors)
                && errors.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                var messages = new List<string>();
                foreach (var field in errors.EnumerateObject())
                    foreach (var msg in field.Value.EnumerateArray())
                        if (msg.GetString() is { Length: > 0 } s) messages.Add(s);
                if (messages.Count > 0) return string.Join(" / ", messages);
            }

            if (root.TryGetProperty("message", out var m) && m.GetString() is { Length: > 0 } text)
                return text;
        }
        catch { /* 본문이 JSON 이 아니면 기본 메시지 */ }
        return null;
    }
}
