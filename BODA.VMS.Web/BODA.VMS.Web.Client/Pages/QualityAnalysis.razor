@page "/quality-analysis"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

<PageTitle>@L["page.paretoAnalysis"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.paretoAnalysis"]</MudText>

@* 7b — 필터 바: 4b 공통 패턴 *@
<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.startDate"]</label>
            <MudDatePicker @bind-Date="_startDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.endDate"]</label>
            <MudDatePicker @bind-Date="_endDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.line"]</label>
            <MudSelect T="int?" @bind-Value="_clientId" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["common.all"]</MudSelectItem>
                @foreach (var c in _clients)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">
                        #@c.ClientIndex.ToString("D2") — @c.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="vms-filter-field" style="min-width:90px;">
            <label class="vms-filter-label">@L["pareto.topN"]</label>
            <MudNumericField T="int" @bind-Value="_topN"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="5" Max="50" />
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Analytics"
                   OnClick="Analyze" Class="vms-btn">@L["action.run"]</MudButton>
    </div>
</MudPaper>

@if (_result is not null)
{
    @* 요약 4카드 — 총 NG 만 레드 *@
    <div class="vms-sum-grid mb-4">
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["pareto.totalInspections"]</span>
            <span class="vms-sum-value mono">@_result.TotalInspections.ToString("N0")</span>
        </MudPaper>
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["pareto.totalNg"]</span>
            <span class="vms-sum-value mono bad">@_result.TotalNgCount.ToString("N0")</span>
        </MudPaper>
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["pareto.uniqueCodes"]</span>
            <span class="vms-sum-value mono">@_result.Entries.Count</span>
        </MudPaper>
        <MudPaper Class="vms-panel vms-sum-card">
            <span class="vms-sum-label">@L["pareto.topShare"]</span>
            <span class="vms-sum-value mono">@(_result.Entries.FirstOrDefault()?.Percentage.ToString("F1") ?? "0")%</span>
        </MudPaper>
    </div>

    @if (_result.Entries.Count > 0)
    {
        @* 콤보 차트 — 막대(건수, 순위별 opacity 감쇠) + 누적선 오렌지 + 80% 기준선 *@
        <MudPaper Class="vms-panel pa-5 mb-4">
            <div class="vms-spc-head">
                <MudText Class="vms-panel-header">@L.Format("pareto.frequencyTitleFmt", _result.Entries.Count)</MudText>
            </div>
            <div class="vms-par-chart">
                @for (var i = 1; i <= 3; i++)
                {
                    <div class="vms-par-grid" style="top:@(i * 25)%"></div>
                }
                <div class="vms-par-limit"></div>
                <span class="vms-par-limit-label">80%</span>
                <div class="vms-par-cols">
                    @foreach (var b in _bars)
                    {
                        <div class="vms-par-col">
                            <span class="vms-par-count @b.LabelClass">@b.Count.ToString("N0")</span>
                            <div class="vms-par-bar"
                                 style="height:@Pct(b.BarHeight); opacity:@b.Opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"></div>
                        </div>
                    }
                </div>
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    <polyline class="vms-par-line" points="@_cumPolyline" />
                </svg>
                @foreach (var b in _bars)
                {
                    <span class="vms-par-pt" style="left:@Pct(b.X); top:@Pct(b.CumY)"></span>
                }
            </div>
            <div class="vms-par-x">
                @foreach (var b in _bars)
                {
                    <span>@b.Code</span>
                }
            </div>
        </MudPaper>

        <div class="vms-table">
            <MudTable Items="_result.Entries" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh Style="width:60px;">@L["pareto.colRank"]</MudTh>
                    <MudTh>@L["pareto.colNgCode"]</MudTh>
                    <MudTh>@L["pareto.colDescription"]</MudTh>
                    <MudTh>@L["pareto.colCategory"]</MudTh>
                    <MudTh>@L["pareto.colSeverity"]</MudTh>
                    <MudTh Style="text-align:right;">@L["pareto.colCount"]</MudTh>
                    <MudTh Style="text-align:right;">@L["pareto.colShare"]</MudTh>
                    <MudTh Style="text-align:right;">@L["pareto.colCumulative"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @{ var rank = _result.Entries.IndexOf(context) + 1; }
                        <span class="vms-mono-dim">@rank</span>
                    </MudTd>
                    <MudTd>
                        <span class="vms-mono vms-par-code">@context.NgCode</span>
                    </MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.Description))
                        {
                            @context.Description
                        }
                        else
                        {
                            <span class="vms-par-unreg">@L["pareto.unregisteredCode"]</span>
                        }
                    </MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.Category))
                        {
                            <span class="vms-type-chip">@context.Category</span>
                        }
                        else { <span class="vms-cell-empty">—</span> }
                    </MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.Severity))
                        {
                            <span class="vms-sev-badge @SevClass(context.Severity)">@context.Severity.ToUpperInvariant()</span>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right;"><span class="vms-mono">@context.Count.ToString("N0")</span></MudTd>
                    <MudTd Style="text-align:right;">
                        <span class="vms-mono-dim">@context.Percentage.ToString("F2")%</span>
                    </MudTd>
                    <MudTd Style="text-align:right;">
                        @* 누적 = 인라인 바 + 모노 수치. 바 색은 누적 임계값 기준 (README 7b) *@
                        <div class="vms-cum-cell">
                            <div class="vms-cum-track">
                                <div class="vms-cum-fill @CumClass(context.CumulativePercentage)"
                                     style="width:@Pct(context.CumulativePercentage)"></div>
                            </div>
                            <span class="vms-cum-value">@context.CumulativePercentage.ToString("F2")%</span>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @{ var lastCum = _result.Entries.Count > 0 ? _result.Entries[^1].CumulativePercentage : 0; }
            <div class="vms-slots-info">
                @L.Format("pareto.bottomSummaryFmt", _result.Entries.Count, lastCum.ToString("F1"))
            </div>
        </div>
    }
    else
    {
        <div class="vms-panel pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large"
                     Style="color: var(--vms-text-secondary); opacity: 0.3;" Class="mb-2" />
            <MudText Style="color: var(--vms-text-secondary);">@L["pareto.noNgData"]</MudText>
        </div>
    }
}
else
{
    <div class="vms-panel pa-8 d-flex flex-column align-center">
        <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large"
                 Style="color: var(--vms-text-secondary); opacity: 0.3;" Class="mb-2" />
        <MudText Style="color: var(--vms-text-secondary);">@L["pareto.promptRun"]</MudText>
    </div>
}

@code {
    private DateTime? _startDate = DateTime.Today.AddDays(-7);
    private DateTime? _endDate = DateTime.Today.AddDays(1);
    private int? _clientId;
    private int _topN = 20;

    private List<ClientDto> _clients = new();
    private ParetoResultDto? _result;

    // 콤보 차트 지오메트리 — 좌표/높이는 0~100 백분율
    private sealed record ParBar(string Code, int Count, double BarHeight, double Opacity,
                                 string LabelClass, double X, double CumY);
    private List<ParBar> _bars = new();
    private string _cumPolyline = "";

    private static string Pct(double v) =>
        v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
        await Analyze();
    }

    private async Task Analyze()
    {
        var q = new List<string>();
        if (_startDate.HasValue) q.Add($"startDate={_startDate.Value:yyyy-MM-ddTHH:mm:ss}");
        if (_endDate.HasValue) q.Add($"endDate={_endDate.Value:yyyy-MM-ddTHH:mm:ss}");
        if (_clientId.HasValue) q.Add($"clientId={_clientId}");
        q.Add($"topN={_topN}");
        var url = "/api/defect-codes/pareto?" + string.Join("&", q);
        try
        {
            _result = await Api.GetAsync<ParetoResultDto>(url);
            BuildChart();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private void BuildChart()
    {
        _bars = new();
        _cumPolyline = "";
        if (_result is null || _result.Entries.Count == 0) return;

        var entries = _result.Entries;
        var n = entries.Count;
        var max = entries.Max(e => e.Count);
        if (max == 0) return;

        var poly = new System.Text.StringBuilder();
        for (var i = 0; i < n; i++)
        {
            var e = entries[i];
            // 순위가 낮아질수록 opacity .55 → .18 감쇠 — 파레토 우선순위 시각화
            var opacity = n == 1 ? 0.55 : 0.55 - (0.55 - 0.18) * i / (n - 1);
            var labelClass = i == 0 ? "c1" : (i <= 2 ? "c2" : "dim");
            var x = (i + 0.5) / n * 100.0;
            var cumY = 100.0 - e.CumulativePercentage;
            _bars.Add(new ParBar(e.NgCode, e.Count, e.Count / (double)max * 82.0, opacity,
                                 labelClass, x, cumY));
            poly.Append(Pt(x)).Append(',').Append(Pt(cumY)).Append(' ');
        }
        _cumPolyline = poly.ToString().TrimEnd();
    }

    private static string Pt(double v) =>
        v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    private static string SevClass(string sev) => sev switch
    {
        "Critical" => "crit",
        "Major" => "warn",
        _ => "info"
    };

    // 누적 바 색 — ≥80% 레드 / ≥50% 앰버 / 그 외 블루 (README 7b)
    private static string CumClass(double pct)
    {
        if (pct >= 80) return "hot";
        if (pct >= 50) return "mid";
        return "low";
    }
}
