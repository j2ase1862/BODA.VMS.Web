@page "/shift-report"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ILocalizer L

<PageTitle>@L["page.shiftReport"] - BODA VMS</PageTitle>

<MudText Typo="Typo.h4" Class="vms-page-title">@L["page.shiftReport"]</MudText>

@* 8a 패턴 — 4b 필터 바 *@
<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.startDate"]</label>
            <MudDatePicker @bind-Date="_startDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.endDate"]</label>
            <MudDatePicker @bind-Date="_endDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="vms-filter-field">
            <label class="vms-filter-label">@L["common.line"]</label>
            <MudSelect T="int?" @bind-Value="_clientId" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">@L["common.all"]</MudSelectItem>
                @foreach (var c in _clients)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">
                        #@c.ClientIndex.ToString("D2") @c.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Schedule"
                   OnClick="Load" Class="vms-btn">@L["action.run"]</MudButton>
    </div>
</MudPaper>

@if (_rows.Count > 0)
{
    @* Shift별 집계 카드 *@
    @* 교대별 집계 — 상단 3px 등급 색띠 + 저채도 (6b 카드 규칙) *@
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:12px;" class="mb-4">
        @foreach (var grp in _rows.GroupBy(r => r.ShiftId))
        {
            var total = grp.Sum(g => g.TotalCount);
            var pass = grp.Sum(g => g.PassCount);
            var ng = total - pass;
            var rate = total > 0 ? Math.Round((double)ng / total * 100, 2) : 0;
            <div class="vms-panel vms-sum-card" style="border-top: 3px solid @RateBorder(rate) !important;">
                <span class="vms-sum-label">@(grp.First().ShiftName)</span>
                <span class="vms-sum-value mono">@total.ToString("N0")</span>
                <span class="vms-sum-sub">
                    <span style="color:#7FA98C;">@L["shiftReport.passLabel"] @pass.ToString("N0")</span>
                    ·
                    <span style="color:#C4756E;">@L["shiftReport.ngLabel"] @ng.ToString("N0")</span>
                </span>
                <span class="vms-sum-sub" style="color:@RateText(rate); font-weight:700;">
                    @L["shiftReport.ngRateLabel"] @rate.ToString("F2")%
                </span>
            </div>
        }
    </div>

    @* 일자 × Shift 매트릭스 *@
    <div class="vms-table">
        <MudTable Items="_rows" Dense="true" Hover="true" Elevation="0">
            <ToolBarContent>
                <MudText Class="vms-panel-header">@L["shiftReport.matrixTitle"]</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@L["shiftReport.colDate"]</MudTh>
                <MudTh>@L["shiftReport.colShift"]</MudTh>
                <MudTh Style="text-align:right;">@L["shiftReport.colTotal"]</MudTh>
                <MudTh Style="text-align:right;">@L["shiftReport.colPass"]</MudTh>
                <MudTh Style="text-align:right;">@L["shiftReport.colNg"]</MudTh>
                <MudTh Style="text-align:right;">@L["shiftReport.colNgRate"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="vms-mono-dim">@context.Date.ToString("yyyy-MM-dd")</span></MudTd>
                <MudTd><span style="font-weight:500;">@context.ShiftName</span></MudTd>
                <MudTd Style="text-align:right;"><span class="vms-mono">@context.TotalCount.ToString("N0")</span></MudTd>
                <MudTd Style="text-align:right;">
                    <span class="vms-qty-pass">@context.PassCount.ToString("N0")</span>
                </MudTd>
                <MudTd Style="text-align:right;">
                    <span class="vms-qty-ng">@context.NgCount.ToString("N0")</span>
                </MudTd>
                <MudTd Style="text-align:right;">
                    <span class="vms-mono" style="color: @RateText(context.NgRate); font-weight: 600;">
                        @context.NgRate.ToString("F2")%
                    </span>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
}
else if (_loaded)
{
    <MudPaper Class="vms-panel">
        <div class="vms-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Schedule" />
            <span class="vms-empty-text">@L["shiftReport.noData"] — @L["shiftReport.noDataHint"]</span>
        </div>
    </MudPaper>
}
else
{
    <MudPaper Class="vms-panel">
        <div class="vms-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Schedule" />
            <span class="vms-empty-text">@L["shiftReport.promptRun"]</span>
        </div>
    </MudPaper>
}

@code {
    private DateTime? _startDate = DateTime.Today.AddDays(-7);
    private DateTime? _endDate = DateTime.Today.AddDays(1);
    private int? _clientId;

    private List<ClientDto> _clients = new();
    private List<ShiftReportEntryDto> _rows = new();
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetAsync<List<ClientDto>>("/api/clients") ?? new();
        await Load();
    }

    private async Task Load()
    {
        if (!_startDate.HasValue || !_endDate.HasValue) return;
        var req = new ShiftReportRequestDto
        {
            StartDate = _startDate.Value.ToUniversalTime(),
            EndDate = _endDate.Value.ToUniversalTime(),
            ClientId = _clientId
        };
        try
        {
            _rows = await Api.PostAsync<ShiftReportRequestDto, List<ShiftReportEntryDto>>(
                "/api/shifts/report", req) ?? new();
            _loaded = true;
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    // 저채도 등급 — 테두리 진한 톤 / 텍스트 밝은 톤 (기존 임계값 유지: ≥5 오류 / ≥1 경고)
    private static string RateBorder(double rate)
    {
        if (rate >= 5) return "#A8443C";
        if (rate >= 1) return "#8A6E37";
        return "#4E8C63";
    }

    private static string RateText(double rate)
    {
        if (rate >= 5) return "#C4756E";
        if (rate >= 1) return "#C9A05A";
        return "#7FA98C";
    }
}
