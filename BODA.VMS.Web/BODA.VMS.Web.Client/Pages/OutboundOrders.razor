@* GS 인증 범위 제외 — 라우트 비활성화(복원 시 아래 주석 해제) *@
@* @page "/outbound-orders" *@
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject ILocalizer L
@inject SignalRService SignalR

<PageTitle>@L["page.outboundOrders"] - BODA VMS</PageTitle>

@* 8a CRUD 패턴 — 헤더 부제, 필터 바(검색) 우측 끝 등록 *@
<div class="vms-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="vms-page-title">@L["page.outboundOrders"]</MudText>
        <div class="vms-page-sub">@L.Format("outbound.totalCountFmt", _items.Count)</div>
    </div>
</div>

<MudPaper Class="vms-filter-bar pa-0 mb-4">
    <div class="vms-filter-flex">
        <div class="vms-filter-field xwide">
            <label class="vms-filter-label">@L["common.search"]</label>
            <MudTextField @bind-Value="_search" Placeholder="@(L["outbound.searchPlaceholder"])"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </div>
        <div class="vms-filter-spacer"></div>
        <AuthorizeView Roles="Admin,User">
            <Authorized>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                           Variant="Variant.Filled" OnClick="OpenCreateDialog" Class="vms-btn">
                    @L["outbound.btnCreate"]
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </div>
</MudPaper>

<div class="vms-table">
    <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0"
              Filter="new Func<OutboundOrderDto, bool>(FilterFunc)">
        <HeaderContent>
            <MudTh>@L["outbound.colOrderNo"]</MudTh>
            <MudTh>@L["outbound.colCustomer"]</MudTh>
            <MudTh>@L["outbound.colDestination"]</MudTh>
            <MudTh>@L["outbound.colLines"]</MudTh>
            <MudTh>@L["common.status"]</MudTh>
            <MudTh Style="text-align: right;">@L["common.actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span class="vms-cell-id">@context.OrderNo</span></MudTd>
            <MudTd>
                @if (string.IsNullOrEmpty(context.CustomerName))
                {
                    <span class="vms-cell-empty">—</span>
                }
                else
                {
                    <span style="font-weight:500;">@context.CustomerName</span>
                }
            </MudTd>
            <MudTd>
                @if (!string.IsNullOrEmpty(context.Destination))
                {
                    <span class="vms-mono" style="color: #C9A05A;">@context.Destination</span>
                }
                else { <span class="vms-cell-empty">—</span> }
            </MudTd>
            <MudTd><span class="vms-mono">@L.Format("outbound.lineCountFmt", context.LineCount)</span></MudTd>
            <MudTd>
                <span class="vms-wo-chip @StatusChipClass(context.Status)">@StatusLabel(context.Status)</span>
            </MudTd>
            <MudTd Style="text-align: right; white-space: nowrap;">
                <AuthorizeView Roles="Admin,User">
                    <Authorized Context="auth1">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action"
                                   OnClick="@(() => OpenEditDialog(context))">@L["workorder.actEdit"]</MudButton>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Admin">
                    <Authorized Context="auth2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="vms-row-action danger"
                                   OnClick="@(() => DeleteItem(context))">@L["workorder.actDelete"]</MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="vms-empty">
                <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" />
                <span class="vms-empty-text">@L["outbound.noItems"] — @L["outbound.noItemsHint"]</span>
            </div>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    private List<OutboundOrderDto> _items = new();
    private bool _loading;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 실시간: 글라스 피킹/출하확정 등 변경을 즉시 반영(새로고침 불필요)
        SignalR.OnOutboundOrderChanged += OnOrderChanged;
        SignalR.OnOutboundOrderDeleted += OnOrderDeleted;
        await Load();
    }

    private async void OnOrderChanged(OutboundOrderDto dto) => await InvokeAsync(() =>
    {
        var i = _items.FindIndex(o => o.Id == dto.Id);
        if (i >= 0) _items[i] = dto; else _items.Insert(0, dto);
        StateHasChanged();
    });

    private async void OnOrderDeleted(int id) => await InvokeAsync(() =>
    {
        _items.RemoveAll(o => o.Id == id);
        StateHasChanged();
    });

    public void Dispose()
    {
        SignalR.OnOutboundOrderChanged -= OnOrderChanged;
        SignalR.OnOutboundOrderDeleted -= OnOrderDeleted;
    }

    private async Task Load()
    {
        _loading = true;
        _items = await Api.GetAsync<List<OutboundOrderDto>>("/api/outbound-orders") ?? new();
        _loading = false;
    }

    private bool FilterFunc(OutboundOrderDto o)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return o.OrderNo.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (o.CustomerName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (o.Destination?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<OutboundOrderFormDialog>
        {
            { x => x.Model, new OutboundOrderDto() },
            { x => x.IsEdit, false }
        };
        var dialog = await Dialog.ShowAsync<OutboundOrderFormDialog>(L["outbound.createTitle"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (OutboundOrderDto)result.Data!;
                await Api.PostAsync<OutboundOrderDto, OutboundOrderDto>("/api/outbound-orders", dto);
                Snackbar.Add(L.Format("outbound.createdFmt", dto.OrderNo), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(OutboundOrderDto src)
    {
        // 깊은 복사 (취소 시 원본 보존)
        var copy = new OutboundOrderDto
        {
            Id = src.Id, OrderNo = src.OrderNo, CustomerName = src.CustomerName,
            ShipTo = src.ShipTo, Destination = src.Destination, Status = src.Status,
            Lines = src.Lines.Select(l => new OutboundOrderLineDto
            {
                Id = l.Id, Barcode = l.Barcode, ItemCode = l.ItemCode,
                ItemName = l.ItemName, Qty = l.Qty, PickedQty = l.PickedQty
            }).ToList()
        };
        var parameters = new DialogParameters<OutboundOrderFormDialog>
        {
            { x => x.Model, copy },
            { x => x.IsEdit, true }
        };
        var dialog = await Dialog.ShowAsync<OutboundOrderFormDialog>(
            L.Format("outbound.editTitleFmt", src.OrderNo), parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                var dto = (OutboundOrderDto)result.Data!;
                await Api.PutAsync<OutboundOrderDto, OutboundOrderDto>($"/api/outbound-orders/{src.Id}", dto);
                Snackbar.Add(L.Format("outbound.updatedFmt", dto.OrderNo), Severity.Success);
                await Load();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
            }
        }
    }

    private async Task DeleteItem(OutboundOrderDto o)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.TargetId, o.OrderNo },
            { x => x.Message, L["confirm.deleteIrreversible"] },
            { x => x.Danger, true },
            { x => x.ConfirmText, L["action.delete"] }
        };
        var dlg = await Dialog.ShowAsync<ConfirmDialog>(L["confirm.delete"], parameters);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await Api.DeleteAsync($"/api/outbound-orders/{o.Id}");
            Snackbar.Add(L.Format("outbound.deletedFmt", o.OrderNo), Severity.Warning);
            await Load();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(L.Format("snackbar.failedFmt", ex.Message), Severity.Error);
        }
    }

    private string StatusLabel(string s) => s switch
    {
        "Pending" => L["outbound.statusPending"],
        "Picking" => L["outbound.statusPicking"],
        "Done"    => L["outbound.statusDone"],
        _ => s
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Pending" => "st-flat",
        "Picking" => "st-run",
        "Done"    => "st-done",
        _ => "st-flat"
    };
}
